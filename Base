                else if (obra.score >= 20) { badgeClass = "risk-med"; riscoTexto = "MÉDIO"; }

                const card = document.createElement('div');
                card.className = "glass rounded-xl overflow-hidden animate-fade-in";
                
                // HTML do Card
                card.innerHTML = `
                    <div class="flex">
                        <!-- Coluna Score -->
                        <div class="w-20 md:w-24 shrink-0 bg-slate-800/50 flex flex-col items-center justify-center border-r border-slate-700/50 p-2">
                            <div class="w-12 h-12 rounded-full ${badgeClass} flex items-center justify-center text-white font-black text-lg shadow-lg mb-1">
                                ${obra.score}
                            </div>
                            <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">${riscoTexto}</span>
                        </div>
                        
                        <!-- Conteúdo -->
                        <div class="flex-grow p-4 min-w-0">
                            <div class="flex items-start justify-between mb-1">
                                <span class="text-[10px] bg-slate-700 text-slate-300 px-1.5 py-0.5 rounded font-mono">${obra.id}</span>
                                <span class="text-[10px] text-slate-400 truncate max-w-[100px]">${obra.municipio}/${obra.uf}</span>
                            </div>
                            
                            <h3 class="text-sm md:text-base font-bold text-white leading-tight mb-3 truncate-2-lines">${obra.nome}</h3>
                            
                            <!-- Barras de Progresso -->
                            <div class="space-y-2 mb-3">
                                <div>
                                    <div class="flex justify-between text-[10px] text-slate-400 mb-0.5">
                                        <span>Físico</span>
                                        <span class="text-blue-400 font-bold">${obra.fisico}%</span>
                                    </div>
                                    <div class="h-1.5 bg-slate-700 rounded-full overflow-hidden">
                                        <div class="h-full bg-blue-500" style="width: ${Math.min(obra.fisico, 100)}%"></div>
                                    </div>
                                </div>
                                <div>
                                    <div class="flex justify-between text-[10px] text-slate-400 mb-0.5">
                                        <span>Financeiro</span>
                                        <span class="${obra.financeiro > obra.fisico + 10 ? 'text-red-400' : 'text-emerald-400'} font-bold">${obra.financeiro}%</span>
                                    </div>
                                    <div class="h-1.5 bg-slate-700 rounded-full overflow-hidden">
                                        <div class="h-full ${obra.financeiro > obra.fisico + 10 ? 'bg-red-500' : 'bg-emerald-500'}" style="width: ${Math.min(obra.financeiro, 100)}%"></div>
                                    </div>
                                </div>
                            </div>

                            <p class="text-[10px] text-slate-500 truncate mb-2">
                                <span class="font-bold text-slate-400">Empresa:</span> ${obra.empresa}
                            </p>

                            <!-- Flags de Risco -->
                            <div class="flex flex-wrap gap-1">
                                ${obra.flags.map(f => `
                                    <span class="text-[9px] border border-slate-700 bg-slate-800/50 px-1.5 py-0.5 rounded ${f.cor} font-medium">
                                        ⚠ ${f.label}
                                    </span>
                                `).join('')}
                            </div>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // ============================================================
        // 4. LÓGICA DE FILTRO (UI)
        // ============================================================

        window.filtrar = function(tipo, btnElement) {
            // UI Update
            document.querySelectorAll('.btn-filter').forEach(b => {
                b.classList.remove('btn-active', 'text-white');
                b.classList.add('text-slate-400');
            });
            btnElement.classList.add('btn-active', 'text-white');
            btnElement.classList.remove('text-slate-400');

            // Logic
            if (tipo === 'RANKING') {
                OBRAS_FILTRADAS = [...OBRAS_GLOBAIS];
            } else if (tipo === 'PARALISADA') {
                OBRAS_FILTRADAS = OBRAS_GLOBAIS.filter(o => 
                    o.status_obra.toLowerCase().includes('parali') || 
                    (diffDias(o.inicio) > 120 && o.fisico < 5)
                );
            } else if (tipo === 'FINANCEIRO') {
                OBRAS_FILTRADAS = OBRAS_GLOBAIS.filter(o => 
                    (o.financeiro - o.fisico) > 10
                );
            }

            renderizarLista();
        }

    </script>
</body>
</html>

