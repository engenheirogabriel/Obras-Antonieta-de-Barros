<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>RevelaGov - Auditoria Universal</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- SheetJS (Lê Excel, XLS, ODS e CSV) -->
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background-color: #0f172a; color: #e2e8f0; }
        .glass { background: rgba(30, 41, 59, 0.85); backdrop-filter: blur(8px); border-bottom: 1px solid rgba(255,255,255,0.1); }
        .card { background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255,255,255,0.05); }
        .btn-active { background-color: #ea580c !important; color: white !important; border-color: #ea580c !important; }
        
        /* Indicadores de Risco */
        .badge-critical { background: linear-gradient(135deg, #ef4444, #b91c1c); box-shadow: 0 2px 10px rgba(239, 68, 68, 0.3); }
        .badge-medium { background: linear-gradient(135deg, #f97316, #c2410c); }
        .badge-low { background: linear-gradient(135deg, #22c55e, #15803d); }

        /* Loader */
        .loader { border: 3px solid rgba(255,255,255,0.1); border-left-color: #f97316; border-radius: 50%; width: 24px; height: 24px; animation: spin 1s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body class="pb-20">

    <!-- HEADER FLUTUANTE -->
    <nav class="glass sticky top-0 z-50 px-4 py-3 shadow-xl flex justify-between items-center">
        <div class="flex items-center gap-2">
            <i data-lucide="eye" class="text-orange-500 w-6 h-6"></i>
            <div>
                <h1 class="font-black text-white text-lg leading-none tracking-tight">REVELA<span class="text-orange-500">GOV</span></h1>
                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wide">Módulo Auditoria</p>
            </div>
        </div>
        
        <label class="bg-blue-600 active:bg-blue-700 text-white px-4 py-2 rounded-full text-xs font-bold flex items-center gap-2 shadow-lg shadow-blue-900/50 transition-transform active:scale-95 cursor-pointer">
            <i data-lucide="folder-open" class="w-4 h-4"></i> ABRIR ARQUIVOS
            <input type="file" id="fileInput" multiple accept=".csv, .xlsx, .xls, .ods" class="hidden" onchange="processarArquivos(this)">
        </label>
    </nav>

    <!-- ÁREA DE MENSAGENS / EMPTY STATE -->
    <div id="statusArea" class="p-6 text-center mt-10 animate-fade-in">
        <div class="bg-slate-800/50 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 border border-slate-700">
            <i data-lucide="file-spreadsheet" class="w-10 h-10 text-slate-500"></i>
        </div>
        <h2 class="text-xl font-bold text-white mb-2">Nenhum dado carregado</h2>
        <p class="text-slate-400 text-sm max-w-xs mx-auto mb-6">
            Importe as planilhas do <strong>Antonieta de Barros</strong> (Excel, CSV ou ODS). O sistema cruzará os dados automaticamente.
        </p>
        <div class="text-[10px] text-slate-600 uppercase font-bold tracking-widest border-t border-slate-800 pt-4 max-w-xs mx-auto">
            Formatos Suportados: .XLSX .CSV .ODS
        </div>
    </div>

    <!-- LOADING OVERLAY -->
    <div id="loadingOverlay" class="hidden fixed inset-0 bg-slate-900/90 z-[60] flex-col items-center justify-center text-center">
        <div class="loader w-12 h-12 mb-4 border-4"></div>
        <h3 class="text-white font-bold text-lg">Processando Base de Dados</h3>
        <p class="text-slate-400 text-sm" id="loadingText">Lendo arquivos...</p>
    </div>

    <!-- DASHBOARD (Conteúdo Principal) -->
    <div id="mainContent" class="hidden px-4 mt-6">
        
        <!-- KPIs -->
        <div class="grid grid-cols-2 gap-3 mb-6">
            <div class="card p-4 rounded-xl relative overflow-hidden">
                <div class="absolute -right-2 -top-2 text-slate-800 opacity-20"><i data-lucide="building-2" class="w-16 h-16"></i></div>
                <div class="text-slate-400 text-[10px] font-bold uppercase">Obras Mapeadas</div>
                <div class="text-3xl font-black text-white" id="kpiCount">0</div>
            </div>
            <div class="card p-4 rounded-xl border-l-4 border-red-500 relative overflow-hidden">
                <div class="absolute -right-2 -top-2 text-red-900 opacity-20"><i data-lucide="alert-triangle" class="w-16 h-16"></i></div>
                <div class="text-red-400 text-[10px] font-bold uppercase">Risco Crítico</div>
                <div class="text-3xl font-black text-white" id="kpiRisk">0</div>
            </div>
            <div class="card p-3 rounded-xl col-span-2 flex justify-between items-center">
                <div>
                    <div class="text-slate-400 text-[10px] font-bold uppercase">Volume de Recursos</div>
                    <div class="text-lg font-black text-emerald-400" id="kpiMoney">R$ 0,00</div>
                </div>
                <i data-lucide="wallet" class="text-emerald-500/50 w-8 h-8"></i>
            </div>
        </div>

        <!-- BARRA DE FILTROS -->
        <div class="flex overflow-x-auto gap-2 mb-6 pb-2 scrollbar-hide">
            <button onclick="aplicarFiltro('TODOS', this)" class="btn-filter btn-active whitespace-nowrap bg-slate-800 text-slate-400 border border-slate-700 px-4 py-2 rounded-lg text-xs font-bold flex items-center gap-2">
                <i data-lucide="list"></i> RANKING GERAL
            </button>
            <button onclick="aplicarFiltro('PARALISADA', this)" class="btn-filter whitespace-nowrap bg-slate-800 text-slate-400 border border-slate-700 px-4 py-2 rounded-lg text-xs font-bold flex items-center gap-2">
                <i data-lucide="pause-circle"></i> PARALISADAS
            </button>
            <button onclick="aplicarFiltro('FINANCEIRO', this)" class="btn-filter whitespace-nowrap bg-slate-800 text-slate-400 border border-slate-700 px-4 py-2 rounded-lg text-xs font-bold flex items-center gap-2">
                <i data-lucide="dollar-sign"></i> SOBREPREÇO
            </button>
            <button onclick="aplicarFiltro('SOCIETARIO', this)" class="btn-filter whitespace-nowrap bg-slate-800 text-slate-400 border border-slate-700 px-4 py-2 rounded-lg text-xs font-bold flex items-center gap-2">
                <i data-lucide="users"></i> EMPRESAS
            </button>
        </div>

        <!-- LISTA DE OBRAS -->
        <div id="listaResultados" class="space-y-4">
            <!-- Cards injetados via JS -->
        </div>

        <div class="text-center text-slate-600 text-xs mt-8 mb-4">
            Fim dos resultados
        </div>
    </div>

    <!-- SCRIPTS (LÓGICA) -->
    <script>
        lucide.createIcons();

        let DATABASE = []; // Banco de dados em memória
        let FILTERED = []; // Dados filtrados visualmente

        // ==========================================
        // 1. LEITURA DE ARQUIVOS (XLSX/CSV)
        // ==========================================
        async function processarArquivos(input) {
            const files = input.files;
            if (!files.length) return;

            // UI Feedback
            document.getElementById('statusArea').classList.add('hidden');
            document.getElementById('loadingOverlay').classList.remove('hidden');
            document.getElementById('loadingOverlay').classList.add('flex');

            let rawData = {
                geral: [],
                contrato: [],
                pagamentos: [],
                prefeitura: [],
                repasses: [],
                historico: []
            };

            // Processa cada arquivo
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                document.getElementById('loadingText').innerText = `Lendo: ${file.name}...`;
                
                try {
                    const data = await lerArquivoExcel(file);
                    identificarTipoENormalizar(data, file.name, rawData);
                } catch (e) {
                    console.error("Erro ao ler " + file.name, e);
                }
            }

            // Cruzamento
            document.getElementById('loadingText').innerText = "Cruzando informações...";
            // Pequeno delay para a UI atualizar
            setTimeout(() => {
                cruzarDados(rawData);
            }, 100);
        }

        function lerArquivoExcel(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    // Pega a primeira aba
                    const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                    // Converte para JSON
                    const jsonData = XLSX.utils.sheet_to_json(firstSheet, { defval: "" });
                    resolve(jsonData);
                };
                reader.onerror = reject;
                reader.readAsArrayBuffer(file);
            });
        }

        // ==========================================
        // 2. INTELIGÊNCIA DE DADOS (NORMALIZAÇÃO)
        // ==========================================
        function identificarTipoENormalizar(json, filename, store) {
            if (!json || json.length === 0) return;
            
            const keys = Object.keys(json[0]).map(k => k.toLowerCase());
            const fname = filename.toLowerCase();

            // Heurística para saber qual arquivo é qual
            if (fname.includes("geral") || keys.includes("situação da obra") || keys.includes("percentual de execução")) {
                store.geral = store.geral.concat(json);
            } else if (fname.includes("contrata") || keys.includes("valor do contrato")) {
                store.contrato = store.contrato.concat(json);
            } else if (fname.includes("pagamento") || keys.includes("valor da nota fiscal (r$)")) {
                store.pagamentos = store.pagamentos.concat(json);
            } else if (fname.includes("repasse") || keys.includes("valor repassado")) {
                store.repasses = store.repasses.concat(json);
            } else if (fname.includes("prefeitura") || keys.includes("razão social")) {
                store.prefeitura = store.prefeitura.concat(json);
            } else if (fname.includes("histórico") || keys.includes("situação atual")) {
                store.historico = store.historico.concat(json);
            }
        }

        // ==========================================
        // 3. CRUZAMENTO E CÁLCULO DE RISCO
        // ==========================================
        function cruzarDados(raw) {
            const obrasMap = {};

            // 3.1. Base Primária (Geral ou Contratos)
            const baseList = raw.geral.length > 0 ? raw.geral : raw.contrato;
            
            if (baseList.length === 0) {
                alert("Não foi possível identificar uma lista base de obras. Certifique-se de carregar o arquivo 'Informações Gerais' ou 'Contratação'.");
                document.getElementById('loadingOverlay').classList.add('hidden');
                document.getElementById('statusArea').classList.remove('hidden');
                return;
            }

            baseList.forEach(row => {
                // Tenta achar ID da Obra (várias possibilidades de header)
                const id = row["ID da obra"] || row["ID"];
                if (!id) return;

                obrasMap[id] = {
                    id: id,
                    nome: row["Nome da obra"] || row["Objeto"] || "Obra sem nome",
                    municipio: row["Município"] || "N/A",
                    uf: row["UF"] || "",
                    status: row["Situação da obra"] || "Desconhecido",
                    fisico: parseBRL(row["Percentual de execução"] || row["% Medição física acumulada"]),
                    financeiro: 0,
                    valor: 0,
                    empresa: "Não Identificada",
                    inicio: null,
                    fim: null,
                    flags: [],
                    score: 0
                };
            });

            // 3.2. Enriquecimento (Contratos)
            raw.contrato.forEach(row => {
                const id = row["ID da obra"];
                if (obrasMap[id]) {
                    obrasMap[id].valor = parseBRL(row["Valor do contrato"]);
                    obrasMap[id].empresa = row["Empresa contratada"] || obrasMap[id].empresa;
                    
                    if(row["Data de início da execução"]) obrasMap[id].inicio = parseData(row["Data de início da execução"]);
                    if(row["Data de término do contrato"]) obrasMap[id].fim = parseData(row["Data de término do contrato"]);
                }
            });

            // 3.3. Cálculo Financeiro (Pagamentos)
            const pagamentosMap = {};
            raw.pagamentos.forEach(row => {
                const id = row["ID da obra"];
                const val = parseBRL(row["Valor da nota fiscal (R$)"] || row["Valor do pagamento"] || row["Valor"]);
                if(id) pagamentosMap[id] = (pagamentosMap[id] || 0) + val;
            });
            
            // Se não tiver tabela Pagamentos, tenta usar Repasses como proxy financeiro
            if (raw.pagamentos.length === 0 && raw.repasses.length > 0) {
                 raw.repasses.forEach(row => {
                    const id = row["ID da obra"];
                    const val = parseBRL(row["Valor repassado"] || row["Valor"]);
                    if(id) pagamentosMap[id] = (pagamentosMap[id] || 0) + val;
                });
            }

            // Aplica financeiro
            Object.keys(obrasMap).forEach(id => {
                const obra = obrasMap[id];
                const pago = pagamentosMap[id] || 0;
                if (obra.valor > 0) {
                    obra.financeiro = (pago / obra.valor) * 100;
                }
            });

            // 3.4. Motor de Risco (Antonieta)
            DATABASE = Object.values(obrasMap).map(calcularRisco);
            DATABASE.sort((a, b) => b.score - a.score); // Ordena por Risco
            
            FILTERED = [...DATABASE];
            renderizarDashboard();
        }

        function calcularRisco(obra) {
            let score = 0;
            let flags = [];
            
            // Helper Dates
            const hoje = new Date();
            const diasObra = obra.inicio ? Math.floor((hoje - obra.inicio) / (1000 * 60 * 60 * 24)) : 0;
            const vencida = obra.fim ? (hoje > obra.fim) : false;

            // [20 pts] Paralisia
            // Status explícito ou (Muitos dias e pouco avanço)
            if (obra.status.toLowerCase().includes("parali") || (diasObra > 120 && obra.fisico < 5)) {
                score += 20;
                flags.push({ tipo: 'CRITICO', msg: 'Paralisia: Sem avanço significativo' });
            }

            // [20 pts] Desequilíbrio Financeiro (Sobrefaturamento)
            // Se pagou 10% a mais do que executou
            if ((obra.financeiro - obra.fisico) > 10) {
                score += 20;
                flags.push({ tipo: 'FINANCEIRO', msg: `Pago ${obra.financeiro.toFixed(0)}% vs Feito ${obra.fisico.toFixed(0)}%` });
            }

            // [20 pts] Prazo Expirado
            if (vencida && obra.fisico < 95 && obra.status.toLowerCase() !== 'concluída') {
                score += 20;
                flags.push({ tipo: 'PRAZO', msg: 'Vigência expirada sem conclusão' });
            }

            // [25 pts] Risco Societário (Heurística)
            // EIRELI ou ME em contrato > 1 Milhão
            const nomeEmpresa = obra.empresa.toUpperCase();
            if ((nomeEmpresa.includes("EIRELI") || nomeEmpresa.includes(" ME ")) && obra.valor > 1000000) {
                score += 25;
                flags.push({ tipo: 'SOCIETARIO', msg: 'Empresa individual em contrato milionário' });
            }

            obra.score = score;
            obra.flags = flags;
            return obra;
        }

        // ==========================================
        // 4. HELPERS DE PARSE
        // ==========================================
        function parseBRL(val) {
            if (!val) return 0;
            if (typeof val === 'number') return val;
            // Remove R$, espaços, pontos de milhar e troca vírgula por ponto
            let clean = val.toString().replace("R$", "").trim().replace(/\./g, "").replace(",", ".");
            // Lida com casos de porcentagem
            clean = clean.replace("%", "");
            return parseFloat(clean) || 0;
        }

        function parseData(dateStr) {
            if (!dateStr) return null;
            // Se for número serial do Excel (ex: 44500)
            if (typeof dateStr === 'number') {
                return new Date(Math.round((dateStr - 25569)*86400*1000));
            }
            // Se for String DD/MM/AAAA ou AAAA-MM-DD
            const parts = dateStr.split(/[\/\-]/);
            if (parts.length === 3) {
                if (parts[0].length === 4) return new Date(parts[0], parts[1]-1, parts[2]); // YYYY-MM-DD
                return new Date(parts[2], parts[1]-1, parts[0]); // DD-MM-YYYY
            }
            return null;
        }

        // ==========================================
        // 5. RENDERIZAÇÃO
        // ==========================================
        function renderizarDashboard() {
            document.getElementById('loadingOverlay').classList.remove('flex');
            document.getElementById('loadingOverlay').classList.add('hidden');
            document.getElementById('mainContent').classList.remove('hidden');

            // Atualiza KPIs
            document.getElementById('kpiCount').innerText = DATABASE.length;
            document.getElementById('kpiRisk').innerText = DATABASE.filter(d => d.score >= 50).length;
            
            const total = DATABASE.reduce((acc, curr) => acc + curr.valor, 0);
            document.getElementById('kpiMoney').innerText = total.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', notation: 'compact' });

            renderizarLista();
        }

        function renderizarLista() {
            const container = document.getElementById('listaResultados');
            container.innerHTML = "";

            if (FILTERED.length === 0) {
                container.innerHTML = `<div class="text-center py-10 text-slate-500">Nenhum resultado para este filtro.</div>`;
                return;
            }

            FILTERED.forEach(obra => {
                let badgeClass = 'badge-low';
                if (obra.score >= 50) badgeClass = 'badge-critical';
                else if (obra.score >= 20) badgeClass = 'badge-medium';

                // Bar Widths
                const fisW = Math.min(obra.fisico, 100);
                const finW = Math.min(obra.financeiro, 100);

                const html = `
                    <div class="card rounded-xl p-0 overflow-hidden animate-fade-in">
                        <div class="flex">
                            <!-- Score -->
                            <div class="w-20 bg-slate-800/50 flex flex-col items-center justify-center border-r border-slate-700/50 p-2 shrink-0">
                                <div class="w-12 h-12 rounded-full ${badgeClass} flex items-center justify-center text-white font-black text-lg shadow-lg mb-1">
                                    ${obra.score}
                                </div>
                                <span class="text-[9px] font-bold text-slate-400 uppercase">Pontos</span>
                            </div>
                            
                            <!-- Info -->
                            <div class="flex-grow p-3 min-w-0">
                                <div class="flex justify-between items-start mb-1">
                                    <span class="bg-slate-700 text-white text-[10px] px-1.5 py-0.5 rounded font-mono">${obra.id}</span>
                                    <span class="text-[10px] text-slate-400 truncate max-w-[100px]">${obra.municipio}/${obra.uf}</span>
                                </div>
                                <h3 class="text-sm font-bold text-white leading-tight mb-3 truncate-2-lines">${obra.nome}</h3>
                                
                                <!-- Barras -->
                                <div class="grid grid-cols-2 gap-3 mb-3">
                                    <div>
                                        <div class="flex justify-between text-[10px] text-slate-400 mb-0.5"><span>Físico</span> <span class="text-blue-400 font-bold">${obra.fisico.toFixed(1)}%</span></div>
                                        <div class="h-1.5 bg-slate-700 rounded-full"><div class="h-full bg-blue-500 rounded-full" style="width:${fisW}%"></div></div>
                                    </div>
                                    <div>
                                        <div class="flex justify-between text-[10px] text-slate-400 mb-0.5"><span>Financeiro</span> <span class="${obra.financeiro > obra.fisico + 10 ? 'text-red-400' : 'text-emerald-400'} font-bold">${obra.financeiro.toFixed(1)}%</span></div>
                                        <div class="h-1.5 bg-slate-700 rounded-full"><div class="h-full ${obra.financeiro > obra.fisico + 10 ? 'bg-red-500' : 'bg-emerald-500'} rounded-full" style="width:${finW}%"></div></div>
                                    </div>
                                </div>

                                <!-- Flags -->
                                <div class="flex flex-wrap gap-1">
                                    ${obra.flags.map(f => `
                                        <span class="text-[9px] border border-red-500/30 bg-red-500/10 text-red-300 px-1.5 py-0.5 rounded flex items-center gap-1">
                                            <i data-lucide="alert-circle" class="w-3 h-3"></i> ${f.msg}
                                        </span>
                                    `).join('')}
                                    ${obra.flags.length === 0 ? '<span class="text-[9px] text-emerald-500 bg-emerald-500/10 px-2 py-0.5 rounded">Regular</span>' : ''}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', html);
            });
            
            lucide.createIcons();
        }

        // ==========================================
        // 6. FILTROS VISUAIS
        // ==========================================
        window.aplicarFiltro = function(tipo, btn) {
            // Update botões
            document.querySelectorAll('.btn-filter').forEach(b => {
                b.classList.remove('btn-active', 'text-white', 'border-orange-500');
                b.classList.add('text-slate-400', 'border-slate-700');
            });
            btn.classList.add('btn-active', 'text-white');
            btn.classList.remove('text-slate-400', 'border-slate-700');

            if (tipo === 'TODOS') {
                FILTERED = [...DATABASE];
            } else if (tipo === 'PARALISADA') {
                FILTERED = DATABASE.filter(o => o.status.toLowerCase().includes("parali") || (o.score >= 20 && o.fisico < 5));
            } else if (tipo === 'FINANCEIRO') {
                FILTERED = DATABASE.filter(o => (o.financeiro - o.fisico) > 10);
            } else if (tipo === 'SOCIETARIO') {
                FILTERED = DATABASE.filter(o => o.flags.some(f => f.tipo === 'SOCIETARIO'));
            }
            
            renderizarLista();
        }

    </script>
</body>
</html>

