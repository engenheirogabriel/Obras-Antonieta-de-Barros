        // Estado Global da Aplicação
        let OBRAS_GLOBAIS = [];
        let OBRAS_FILTRADAS = [];

        // ============================================================
        // 1. UTILITÁRIOS
        // ============================================================
        
        // Converte string brasileira (1.200,50) para float JS (1200.50)
        const parseBRL = (valor) => {
            if (!valor) return 0.0;
            if (typeof valor === 'number') return valor;
            const limpo = valor.toString().replace("R$", "").trim().replace(/\./g, "").replace(",", ".");
            return parseFloat(limpo) || 0.0;
        };

        // Calcula dias entre datas
        const diffDias = (dataStr) => {
            if (!dataStr) return 0;
            const partes = dataStr.split('/'); // Assumindo DD/MM/AAAA ou AAAA-MM-DD
            let dt;
            if (partes.length === 3 && partes[2].length === 4) {
                 dt = new Date(`${partes[2]}-${partes[1]}-${partes[0]}`);
            } else {
                dt = new Date(dataStr);
            }
            if (isNaN(dt)) return 0;
            const diff = new Date() - dt;
            return Math.floor(diff / (1000 * 60 * 60 * 24));
        };

        // ============================================================
        // 2. PROCESSAMENTO DE ARQUIVOS (O CORAÇÃO DO SISTEMA)
        // ============================================================
        
        function handleFileUpload(evt) {
            const files = evt.target.files;
            if (!files.length) return;

            document.getElementById('emptyState').classList.add('hidden');
            document.getElementById('dashboard').classList.add('hidden');
            document.getElementById('loadingState').classList.remove('hidden');
            document.getElementById('loadingState').classList.add('flex');

            let filesRead = 0;
            let rawData = {}; // Armazena dados brutos de cada arquivo

            Array.from(files).forEach(file => {
                Papa.parse(file, {
                    header: true,
                    skipEmptyLines: true,
                    encoding: "ISO-8859-1", // Padrão Excel Brasil
                    complete: function(results) {
                        // Tenta adivinhar o tipo do arquivo pelo cabeçalho
                        const cols = results.meta.fields || [];
                        const filename = file.name.toLowerCase();
                        
                        // Mapeamento baseado nos nomes dos arquivos enviados pelo usuário
                        if (filename.includes("informações gerais") || cols.includes("Percentual de execução")) {
                            rawData.geral = results.data;
                        } else if (filename.includes("contratação") || cols.includes("Empresa contratada")) {
                            rawData.contrato = results.data;
                        } else if (filename.includes("repasse") || cols.includes("Valor repassado")) {
                            rawData.repasse = results.data; // Para financeiro se não tiver pagamentos
                        } else if (filename.includes("pagamentos") || cols.includes("Valor do pagamento")) {
                            rawData.pagamentos = results.data;
                        } else if (filename.includes("dados da prefeitura")) {
                            rawData.prefeitura = results.data;
                        }

                        filesRead++;
                        document.getElementById('loadingStatus').innerText = `Lendo: ${file.name} (${filesRead}/${files.length})`;

                        if (filesRead === files.length) {
                            processarDadosCruzados(rawData);
                        }
                    }
                });
            });
        }

        function processarDadosCruzados(raw) {
            const mapaObras = {};

            // 1. Base Principal: Informações Gerais
            const listaBase = raw.geral || raw.contrato || [];
            if (listaBase.length === 0) {
                alert("Erro: Arquivo 'Informações Gerais' ou 'Contratação' não identificado. O sistema precisa de uma lista base de obras.");
                window.location.reload();
                return;
            }

            // 2. Construção do Objeto Mestre
            listaBase.forEach(row => {
                const id = row["ID da obra"];
                if (!id) return;

                mapaObras[id] = {
                    id: id,
                    nome: row["Nome da obra"] || row["Objeto"] || "Obra sem nome",
                    municipio: row["Município"] || "N/A",
                    uf: row["UF"] || "",
                    status_obra: row["Situação da obra"] || "Desconhecido",
                    fisico: parseBRL(row["Percentual de execução"] || row["% Medição física acumulada"] || "0"),
                    financeiro: 0, // Será preenchido depois
                    valor: 0,
                    empresa: "Não Informado",
                    inicio: "",
                    fim: "",
                    flags: [],
                    score: 0
                };
            });

            // 3. Enriquecimento com Dados de Contrato
            if (raw.contrato) {
                raw.contrato.forEach(row => {
                    const id = row["ID da obra"];
                    if (mapaObras[id]) {
                        mapaObras[id].valor = parseBRL(row["Valor do contrato"]);
                        mapaObras[id].empresa = row["Empresa contratada"] || mapaObras[id].empresa;
                        mapaObras[id].inicio = row["Data de início da execução"];
                        mapaObras[id].fim = row["Data de término do contrato"];
                    }
                });
            }

            // 4. Cálculo Financeiro (Soma de Pagamentos)
            // Se tiver tabela de pagamentos, somamos por ID
            if (raw.pagamentos) {
                const pagamentosPorObra = {};
                raw.pagamentos.forEach(row => {
                    const id = row["ID da obra"];
                    const valor = parseBRL(row["Valor da nota fiscal (R$)"] || row["Valor"]);
                    if (id) {
                        pagamentosPorObra[id] = (pagamentosPorObra[id] || 0) + valor;
                    }
                });
                
                // Calcula % financeiro
                for (const id in mapaObras) {
                    const pago = pagamentosPorObra[id] || 0;
                    const total = mapaObras[id].valor;
                    if (total > 0) {
                        mapaObras[id].financeiro = (pago / total) * 100;
                    }
                }
            } else if (raw.geral) {
                // Tenta pegar de coluna se existir no geral
                // Algumas planilhas tem "% Financeiro" direto
            }

            // 5. Motor de Risco (Antonieta Logic)
            OBRAS_GLOBAIS = Object.values(mapaObras).map(obra => calcularRisco(obra));
            
            // Ordena por Risco
            OBRAS_GLOBAIS.sort((a, b) => b.score - a.score);
            OBRAS_FILTRADAS = [...OBRAS_GLOBAIS];

            renderizarDashboard();
        }

        function calcularRisco(obra) {
            let score = 0;
            let flags = [];
            
            // Tratamento de dados numéricos para display (2 casas decimais)
            obra.fisico = parseFloat(obra.fisico.toFixed(2));
            obra.financeiro = parseFloat(obra.financeiro.toFixed(2));

            // [PESO 20] Paralisia
            const diasObra = diffDias(obra.inicio);
            if (obra.status_obra.toLowerCase().includes("parali") || (diasObra > 120 && obra.fisico < 5)) {
                score += 20;
                flags.push({label: "Paralisia Detectada", cor: "text-red-400"});
            }

            // [PESO 20] Sobrefaturamento / Avanço Desproporcional
            if ((obra.financeiro - obra.fisico) > 10) {
                score += 20;
                flags.push({label: `Financeiro (${obra.financeiro}%) > Físico (${obra.fisico}%)`, cor: "text-orange-400"});
            }

            // [PESO 20] Prazo Expirado
            if (obra.fim) {
                const diasVencido = diffDias(obra.fim); // se positivo, venceu
                if (diasVencido > 0 && obra.fisico < 95) {
                    score += 20;
                    flags.push({label: "Vigência Expirada", cor: "text-red-400"});
                }
            }
            
            // [PESO 25] Risco Societário (Heurística simples por nome, já que não temos Capital Social nos CSVs básicos)
            if (obra.empresa && obra.empresa.toUpperCase().includes("EIRELI") && obra.valor > 1000000) {
                score += 25;
                flags.push({label: "EIRELI em Contrato Milionário", cor: "text-purple-400"});
            }

            obra.score = score;
            obra.flags = flags;
            return obra;
        }

        // ============================================================
        // 3. RENDERIZAÇÃO (UI)
        // ============================================================

        function renderizarDashboard() {
            // Esconde loading, mostra dashboard
            document.getElementById('loadingState').classList.remove('flex');
            document.getElementById('loadingState').classList.add('hidden');
            document.getElementById('dashboard').classList.remove('hidden');

            // Atualiza KPIs
            document.getElementById('kpiTotal').innerText = OBRAS_GLOBAIS.length;
            document.getElementById('kpiCritico').innerText = OBRAS_GLOBAIS.filter(o => o.score >= 50).length;
            document.getElementById('kpiMun').innerText = new Set(OBRAS_GLOBAIS.map(o => o.municipio)).size;
            
            const totalVal = OBRAS_GLOBAIS.reduce((acc, curr) => acc + curr.valor, 0);
            document.getElementById('kpiValor').innerText = totalVal.toLocaleString('pt-BR', {style: 'currency', currency: 'BRL', maximumFractionDigits: 0});

            renderizarLista();
        }

        function renderizarLista() {
            const container = document.getElementById('listaObras');
            container.innerHTML = "";

            if (OBRAS_FILTRADAS.length === 0) {
                container.innerHTML = `<div class="text-center py-10 text-slate-500">Nenhuma obra encontrada neste filtro.</div>`;
                return;
            }

            OBRAS_FILTRADAS.forEach(obra => {
                // Define cor do badge
                let badgeClass = "risk-low";
