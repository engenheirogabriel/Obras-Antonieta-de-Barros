<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>FTC Transparência - Malha Fina + Regra 19</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- PapaParse (CSV) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>

    <!-- SheetJS (Excel) -->
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background-color: #0f172a; color: #e2e8f0; }
        .glass { background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255,255,255,0.1); }
        .card { background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255,255,255,0.05); transition: all 0.2s; cursor: pointer; }
        .card:hover { background: rgba(30, 41, 59, 0.9); border-color: rgba(59, 130, 246, 0.4); transform: translateY(-2px); }
        
        /* Tags de Pontuação e Risco */
        .tag-score { font-size: 10px; font-weight: 800; padding: 2px 6px; border-radius: 4px; text-transform: uppercase; }
        .tag-p5 { background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); }
        .tag-p10 { background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); }
        .tag-p15 { background: rgba(234, 179, 8, 0.15); color: #facc15; border: 1px solid rgba(234, 179, 8, 0.3); }
        .tag-p20 { background: rgba(249, 115, 22, 0.15); color: #fdba74; border: 1px solid rgba(249, 115, 22, 0.3); }
        .tag-p25 { background: rgba(239, 68, 68, 0.15); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.3); }

        /* Barras de Progresso */
        .bar-container { background: #334155; height: 6px; border-radius: 3px; overflow: hidden; width: 100%; }
        .bar-fill { height: 100%; transition: width 0.5s; }
        .bar-phys { background-color: #3b82f6; }
        .bar-fin-ok { background-color: #10b981; }
        .bar-fin-high { background-color: #ef4444; } /* Sobrefaturamento */
        .bar-fin-low { background-color: #f59e0b; } /* Represamento */

        /* Modal */
        .modal-overlay { background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(4px); }
        .detail-item { border-left: 2px solid #334155; padding-left: 12px; margin-bottom: 12px; }
        
        .loader { border: 3px solid rgba(255,255,255,0.1); border-left-color: #3b82f6; border-radius: 50%; width: 24px; height: 24px; animation: spin 1s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body class="pb-20">

    <!-- HEADER -->
    <nav class="glass sticky top-0 z-50 px-4 py-3 shadow-2xl">
        <div class="flex justify-between items-center mb-4">
            <div class="flex items-center gap-3">
                <div class="bg-blue-600 p-2 rounded-lg shadow-lg">
                    <i data-lucide="clipboard-check" class="text-white w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="font-black text-white text-lg leading-none tracking-tight">FTC <span class="text-blue-500">TRANSPARÊNCIA</span></h1>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wide">Auditoria Completa (19 Regras)</p>
                </div>
            </div>
            
            <label class="bg-slate-800 hover:bg-slate-700 text-white px-3 py-2 rounded-lg text-xs font-bold flex items-center gap-2 cursor-pointer border border-slate-700 transition shadow-lg">
                <i data-lucide="folder-open" class="w-4 h-4 text-blue-400"></i> CARREGAR DADOS
                <input type="file" id="fileInput" multiple accept=".csv, .xlsx, .xls, .ods" class="hidden" onchange="iniciarProcessamento(this)">
            </label>
        </div>

        <!-- ABAS -->
        <div class="flex gap-2">
            <button onclick="mudarAba('ENTES')" id="tabEntes" class="flex-1 bg-slate-800 border border-slate-700 text-slate-400 hover:text-white px-4 py-3 rounded-lg flex items-center justify-center gap-2 transition font-bold text-xs uppercase" disabled>
                <i data-lucide="landmark" class="w-4 h-4"></i> Entes
            </button>
            <button onclick="mudarAba('OBRAS')" id="tabObras" class="flex-1 bg-slate-800 border border-slate-700 text-slate-400 hover:text-white px-4 py-3 rounded-lg flex items-center justify-center gap-2 transition font-bold text-xs uppercase" disabled>
                <i data-lucide="hard-hat" class="w-4 h-4"></i> Obras
            </button>
        </div>
    </nav>

    <!-- LOADING / EMPTY STATE -->
    <div id="loadingOverlay" class="hidden fixed inset-0 z-[60] flex-col items-center justify-center text-center px-6 modal-overlay">
        <div class="loader w-12 h-12 mb-4 border-4"></div>
        <h3 class="text-white font-bold text-lg mb-1">Processando Algoritmo</h3>
        <p class="text-slate-400 text-sm mb-4">Verificando Vistorias, Prazos e Financeiro...</p>
        <div class="w-full max-w-xs bg-slate-800 rounded-full h-1.5 overflow-hidden">
            <div id="progressBar" class="bg-blue-500 h-full transition-all duration-300" style="width: 0%"></div>
        </div>
    </div>

    <div id="emptyState" class="p-10 text-center mt-8 animate-fade-in">
        <div class="bg-slate-800/50 w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6 border border-slate-700 shadow-inner">
            <i data-lucide="file-bar-chart-2" class="w-10 h-10 text-slate-500"></i>
        </div>
        <h2 class="text-xl font-bold text-white mb-2">Aguardando Base de Dados</h2>
        <p class="text-slate-400 text-xs max-w-sm mx-auto leading-relaxed mb-6">
            Importe as planilhas do <strong>Antonieta de Barros</strong>. O sistema aplicará a Regra 19 (Vistorias > 45 dias) e outras 18 validações.
        </p>
    </div>

    <!-- CONTEÚDO PRINCIPAL -->
    <div id="mainContent" class="hidden px-4 mt-6">
        <div class="flex justify-between items-end mb-4 border-b border-slate-700 pb-2">
            <div>
                <h2 class="text-xl font-black text-white uppercase tracking-tight" id="viewTitle">Ranking</h2>
                <p class="text-[10px] text-slate-400" id="viewSubtitle">Ordenado por Pontuação de Risco</p>
            </div>
            <div class="text-right">
                <div class="text-3xl font-black text-orange-500" id="kpiTotalRisk">0</div>
                <div class="text-[9px] font-bold text-slate-500 uppercase">Alertas Totais</div>
            </div>
        </div>

        <div id="resultsList" class="space-y-3 pb-8"></div>
    </div>

    <!-- MODAL DE DETALHES -->
    <div id="detailModal" class="hidden fixed inset-0 z-[70] flex items-end sm:items-center justify-center modal-overlay p-0 sm:p-4">
        <div class="bg-slate-900 w-full max-w-2xl sm:rounded-2xl rounded-t-2xl border border-slate-700 shadow-2xl flex flex-col max-h-[90vh]">
            <!-- Header Modal -->
            <div class="p-5 border-b border-slate-700 bg-slate-800 sm:rounded-t-2xl flex justify-between items-start">
                <div>
                    <span class="text-[10px] font-bold bg-blue-900/30 text-blue-300 px-2 py-1 rounded uppercase tracking-wide" id="modalType">OBRA</span>
                    <h3 class="font-bold text-white text-lg mt-2 leading-tight" id="modalTitle">Título da Obra</h3>
                    <p class="text-xs text-slate-400 mt-1" id="modalSubtitle">Municipio - UF</p>
                </div>
                <button onclick="fecharModal()" class="p-2 bg-slate-700 rounded-full text-slate-300 hover:text-white transition">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            
            <!-- Body Modal -->
            <div class="p-5 overflow-y-auto" id="modalContent">
                <!-- Conteúdo Injetado via JS -->
            </div>
            
            <!-- Footer Modal -->
            <div class="p-4 border-t border-slate-700 bg-slate-800 sm:rounded-b-2xl flex justify-between items-center">
                <span class="text-xs text-slate-400 font-bold uppercase">Pontuação Acumulada</span>
                <span class="text-3xl font-black text-red-500" id="modalScore">0</span>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();

        // --- ESTADO GLOBAL ---
        let DB = { obras: [], entes: {} };
        let VIEW = { mode: 'ENTES', list: [] };

        // ============================================================
        // 1. LEITURA DE ARQUIVOS
        // ============================================================
        async function iniciarProcessamento(input) {
            const files = Array.from(input.files);
            if (!files.length) return;

            document.getElementById('loadingOverlay').classList.remove('hidden');
            document.getElementById('loadingOverlay').classList.add('flex');
            
            let rawData = { geral: [], contrato: [], pagamentos: [], termos: [], historico: [] };
            let processed = 0;

            const updateProg = () => {
                processed++;
                document.getElementById('progressBar').style.width = `${(processed / files.length) * 100}%`;
            };

            const promises = files.map(file => new Promise(resolve => {
                const ext = file.name.split('.').pop().toLowerCase();
                
                if (ext === 'csv') {
                    Papa.parse(file, {
                        header: true, skipEmptyLines: true, worker: true, encoding: "ISO-8859-1",
                        complete: (res) => { categorizar(res.data, file.name, rawData); updateProg(); resolve(); }
                    });
                } else {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const wb = XLSX.read(new Uint8Array(e.target.result), { type: 'array' });
                        const json = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { defval: "" });
                        categorizar(json, file.name, rawData);
                        updateProg(); resolve();
                    };
                    reader.readAsArrayBuffer(file);
                }
            }));

            await Promise.all(promises);
            // Delay para UI atualizar
            setTimeout(() => processarMalhaFina(rawData), 500);
        }

        function categorizar(json, fname, store) {
            if (!json || !json.length) return;
            fname = fname.toLowerCase();
            const keys = Object.keys(json[0]).map(k => k.toLowerCase());
            
            if (fname.includes("geral") || keys.includes("situação da obra")) store.geral.push(...json);
            else if (fname.includes("contrata")) store.contrato.push(...json);
            else if (fname.includes("pagamento") || keys.includes("valor da nota fiscal (r$)")) store.pagamentos.push(...json);
            else if (fname.includes("termos") || keys.includes("número do termo")) store.termos.push(...json);
            else if (fname.includes("histórico")) store.historico.push(...json);
        }

        // ============================================================
        // 2. MOTOR DE INFERÊNCIA (19 REGRAS)
        // ============================================================
        function processarMalhaFina(raw) {
            DB = { obras: [], entes: {} };
            const mapObras = {};

            // 1. Indexar Pagamentos
            const pagamentos = {};
            raw.pagamentos.forEach(row => {
                const id = row["ID da obra"] || row["ID"];
                const val = parseMoney(row["Valor da nota fiscal (R$)"] || row["Valor"] || row["Valor do pagamento"]);
                if(id) pagamentos[id] = (pagamentos[id] || 0) + val;
            });

            // 2. Base Geral
            const base = raw.geral.length ? raw.geral : raw.contrato;
            
            base.forEach(row => {
                const id = row["ID da obra"] || row["ID"];
                if(!id) return;

                mapObras[id] = {
                    id: id,
                    nome: row["Nome da obra"] || row["Objeto"] || "Obra sem nome",
                    municipio: row["Município"] || "N/A",
                    uf: row["UF"] || "",
                    ente: row["Município"] ? `Pref. ${row["Município"]}` : "Ente Desconhecido",
                    status: row["Situação da obra"] || "N/A",
                    fisico: parseMoney(row["Percentual de execução"] || row["% Medição física acumulada"]),
                    financeiro: 0, 
                    valor: 0,
                    empresa: "Não Informada",
                    cnpj: null,
                    data_termo: parseDate(row["Data da assinatura do termo"]),
                    data_inicio: null,
                    data_fim: null,
                    manifestacao: row["Data da manifestação de interesse à repactuação"], 
                    vistoria: row["Data da última vistoria"], 
                    score: 0,
                    regras_quebradas: [] 
                };
            });

            // 3. Enriquecer com Dados de Contrato
            raw.contrato.forEach(row => {
                const id = row["ID da obra"];
                if(mapObras[id]) {
                    mapObras[id].valor = parseMoney(row["Valor do contrato"]);
                    mapObras[id].data_inicio = parseDate(row["Data de início da execução"] || row["Data da ordem de serviço"]);
                    mapObras[id].data_fim = parseDate(row["Data de término do contrato"]);
                    
                    const empStr = row["Empresa contratada"];
                    if(empStr) {
                        const m = empStr.match(/\((\d+)\)\s*(.*)/);
                        if(m) { mapObras[id].cnpj = m[1]; mapObras[id].empresa = m[2]; }
                        else mapObras[id].empresa = empStr;
                    }
                }
            });

            // 4. APLICAÇÃO DAS REGRAS
            Object.values(mapObras).forEach(obra => {
                if(obra.valor > 0) obra.financeiro = (pagamentos[obra.id] || 0) / obra.valor * 100;
                
                const hoje = new Date();
                const diasDecorridos = obra.data_inicio ? diffDays(obra.data_inicio, hoje) : 0;
                const diasTermo = obra.data_termo ? diffDays(obra.data_termo, hoje) : 0;

                // --- COLUNA 1 (Peso 5): Transparência ---
                if(diasDecorridos > 180 && (obra.fisico === 0 && !obra.empresa)) {
                    flag(obra, 5, "Falta de Transparência: Obra iniciada (teoricamente) sem dados de execução.");
                }

                // --- COLUNA 2 (Peso 10): Adesão/FNDE ---
                if(['Elegível', 'Pactuado'].includes(obra.status) && !obra.manifestacao && diasTermo > 90) {
                    flag(obra, 10, "Obra Elegível/Pactuada sem Manifestação de Interesse.");
                }
                if(['Indeferido', 'Em Análise', 'Diligência'].includes(obra.status)) {
                    flag(obra, 10, `Travamento Administrativo: Status '${obra.status}'.`);
                }
                if(obra.fisico > 10 && !obra.data_termo) {
                    flag(obra, 10, "Execução iniciada sem Termo de Pactuação publicado.");
                }

                // --- COLUNA 3 (Peso 15): Prazos Adm ---
                if(obra.data_termo && !obra.data_inicio && diasTermo > 365) {
                    flag(obra, 15, "Sem Ordem de Serviço (OS) há mais de 12 meses.");
                }

                // --- COLUNA 4 (Peso 20): Execução ---
                if(diasDecorridos > 120 && obra.fisico < 5) {
                    flag(obra, 20, "Paralisia Inicial: <5% executado em 120 dias.");
                }
                if(diasDecorridos > 365 && obra.fisico < 15) {
                    flag(obra, 20, "Lentidão Crítica: <15% executado em 1 ano.");
                }
                
                // === REGRA 12: DESCOMPASSO (DUAS PONTAS) ===
                if((obra.financeiro - obra.fisico) > 10) {
                    flag(obra, 20, `SOBREPREÇO POTENCIAL: Pago ${obra.financeiro.toFixed(1)}% vs Executado ${obra.fisico.toFixed(1)}%.`);
                }
                if((obra.fisico - obra.financeiro) > 10) {
                    flag(obra, 20, `REPRESAMENTO DE RECURSOS: Executado ${obra.fisico.toFixed(1)}% vs Pago ${obra.financeiro.toFixed(1)}%.`);
                }

                if(diasDecorridos > 730 && obra.fisico < 99 && !isConcluida(obra.status)) {
                    flag(obra, 20, "Obra não concluída em 24 meses do início.");
                }

                // --- COLUNA 5 (Peso 10): Técnico ---
                // === REGRA 19: VISTORIA DESATUALIZADA ===
                const dataVistoria = parseDate(obra.vistoria);
                const diasSemVistoria = dataVistoria ? diffDays(dataVistoria, hoje) : null;
                
                // 19.A: Sem Vistoria
                if (!obra.vistoria) {
                    flag(obra, 10, "REGRA 19: Ausência total de registro de vistoria (SIMEC/TransfereGov).");
                } 
                // 19.B: Vistoria Antiga (>45 dias) E NÃO Concluída
                else if (diasSemVistoria > 45 && !isConcluida(obra.status)) {
                    flag(obra, 10, `REGRA 19: Vistoria desatualizada há ${diasSemVistoria} dias (>45 dias limite).`);
                }

                // --- COLUNA 6 (Peso 25): Societário ---
                if(obra.empresa) {
                    const nome = obra.empresa.toUpperCase();
                    if((nome.includes("EIRELI") || nome.includes(" ME ") || nome.includes("MICROEMPRESA")) && obra.valor > 1500000) {
                        flag(obra, 25, `Risco Societário: Empresa Pequena em contrato vultuoso.`);
                    }
                }

                DB.obras.push(obra);

                if(!DB.entes[obra.municipio]) {
                    DB.entes[obra.municipio] = { 
                        nome: obra.municipio, 
                        uf: obra.uf, 
                        total_obras: 0, 
                        risco_acumulado: 0, 
                        alertas_unicos: new Set()
                    };
                }
                const ente = DB.entes[obra.municipio];
                ente.total_obras++;
                ente.risco_acumulado += obra.score;
                obra.regras_quebradas.forEach(r => ente.alertas_unicos.add(r.desc));
            });

            DB.obras.sort((a,b) => b.score - a.score);
            
            document.getElementById('loadingOverlay').classList.add('hidden');
            document.getElementById('emptyState').classList.add('hidden');
            document.getElementById('mainContent').classList.remove('hidden');
            document.getElementById('tabEntes').disabled = false;
            document.getElementById('tabObras').disabled = false;
            
            mudarAba('ENTES');
        }

        function flag(obra, pts, desc) {
            obra.score += pts;
            obra.regras_quebradas.push({ peso: pts, desc: desc });
        }

        function isConcluida(status) {
            if(!status) return false;
            const s = status.toLowerCase();
            return s.includes('concluida') || s.includes('concluída') || s.includes('concluido');
        }

        // ============================================================
        // 3. UI VISUALIZAÇÃO
        // ============================================================
        function mudarAba(aba) {
            VIEW.mode = aba;
            const btnEntes = document.getElementById('tabEntes');
            const btnObras = document.getElementById('tabObras');

            btnEntes.className = "flex-1 bg-slate-800 border border-slate-700 text-slate-400 hover:text-white px-4 py-3 rounded-lg flex items-center justify-center gap-2 transition font-bold text-xs uppercase";
            btnObras.className = "flex-1 bg-slate-800 border border-slate-700 text-slate-400 hover:text-white px-4 py-3 rounded-lg flex items-center justify-center gap-2 transition font-bold text-xs uppercase";

            if (aba === 'ENTES') {
                btnEntes.className = "flex-1 bg-blue-600 text-white border border-blue-500 px-4 py-3 rounded-lg flex items-center justify-center gap-2 transition font-bold text-xs uppercase shadow-lg";
                VIEW.list = Object.values(DB.entes).sort((a,b) => b.risco_acumulado - a.risco_acumulado);
                document.getElementById('viewTitle').innerText = "Ranking de Entes";
                document.getElementById('viewSubtitle').innerText = "Classificado por acúmulo de irregularidades";
            } else {
                btnObras.className = "flex-1 bg-blue-600 text-white border border-blue-500 px-4 py-3 rounded-lg flex items-center justify-center gap-2 transition font-bold text-xs uppercase shadow-lg";
                VIEW.list = DB.obras.sort((a,b) => b.score - a.score);
                document.getElementById('viewTitle').innerText = "Ranking de Obras";
                document.getElementById('viewSubtitle').innerText = "Classificado por gravidade das regras (Malha Fina)";
            }

            const total = VIEW.list.reduce((acc, i) => acc + (i.score || i.risco_acumulado || 0), 0);
            document.getElementById('kpiTotalRisk').innerText = total.toLocaleString();

            renderizarLista();
        }

        function renderizarLista() {
            const container = document.getElementById('resultsList');
            container.innerHTML = "";

            if (VIEW.list.length === 0) {
                container.innerHTML = `<div class="text-center text-slate-500 py-10">Nenhum dado encontrado.</div>`;
                return;
            }

            VIEW.list.slice(0, 100).forEach((item, idx) => {
                let html = "";
                
                if (VIEW.mode === 'ENTES') {
                    const topAlerts = Array.from(item.alertas_unicos).slice(0, 2);
                    html = `
                    <div class="card p-4 rounded-xl flex items-center gap-4" onclick="abrirModalEnte('${item.nome}')">
                        <div class="text-2xl font-black text-slate-600 w-8">#${idx+1}</div>
                        <div class="flex-1 min-w-0">
                            <h3 class="text-white font-bold text-sm truncate">${item.nome}</h3>
                            <div class="text-[10px] text-slate-400 mt-1">${item.uf} • ${item.total_obras} Obras</div>
                            <div class="mt-2 flex flex-wrap gap-1">
                                ${topAlerts.map(a => `<span class="bg-slate-800 text-slate-300 px-1.5 py-0.5 rounded text-[9px] border border-slate-700 truncate max-w-[200px]">${a}</span>`).join('')}
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-2xl font-black text-orange-500">${item.risco_acumulado}</div>
                            <div class="text-[8px] uppercase font-bold text-slate-500">Pts Totais</div>
                        </div>
                    </div>`;
                } else {
                    const topRule = item.regras_quebradas.length > 0 ? item.regras_quebradas[0] : null;
                    const borderClass = item.score >= 50 ? 'border-l-4 border-red-500' : (item.score >= 20 ? 'border-l-4 border-orange-500' : 'border-l-4 border-emerald-500');
                    
                    let barFinClass = "bar-fin-ok";
                    if ((item.financeiro - item.fisico) > 10) barFinClass = "bar-fin-high"; 
                    else if ((item.fisico - item.financeiro) > 10) barFinClass = "bar-fin-low"; 

                    html = `
                    <div class="card p-3 rounded-xl ${borderClass}" onclick="abrirModalObra('${item.id}')">
                        <div class="flex justify-between items-start mb-2">
                            <span class="bg-slate-800 text-slate-300 text-[9px] px-1.5 rounded font-mono border border-slate-700">${item.id}</span>
                            <span class="text-[10px] text-slate-400 truncate w-32 text-right">${item.municipio}</span>
                        </div>
                        <h3 class="text-sm font-bold text-white mb-3 leading-tight line-clamp-2">${item.nome}</h3>
                        
                        <div class="space-y-1 mb-3">
                            <div class="flex justify-between text-[10px] text-slate-400"><span>Físico: ${item.fisico.toFixed(1)}%</span></div>
                            <div class="bar-container"><div class="bar-fill bar-phys" style="width: ${item.fisico}%"></div></div>
                            
                            <div class="flex justify-between text-[10px] text-slate-400 mt-1"><span>Financeiro: ${item.financeiro.toFixed(1)}%</span></div>
                            <div class="bar-container"><div class="bar-fill ${barFinClass}" style="width: ${item.financeiro}%"></div></div>
                        </div>

                        ${topRule ? `
                        <div class="flex items-center gap-2 mt-2 bg-slate-900/50 p-1.5 rounded">
                            <span class="tag-p${topRule.peso} tag-score">+${topRule.peso}</span>
                            <span class="text-[10px] text-slate-300 truncate font-medium">${topRule.desc}</span>
                        </div>
                        ` : ''}
                    </div>`;
                }
                container.insertAdjacentHTML('beforeend', html);
            });
        }

        // ============================================================
        // 4. MODAIS
        // ============================================================
        function abrirModalObra(id) {
            const obra = DB.obras.find(o => o.id === id);
            if(!obra) return;

            document.getElementById('modalType').innerText = "OBRA";
            document.getElementById('modalTitle').innerText = obra.nome;
            document.getElementById('modalSubtitle').innerText = `${obra.municipio} - ${obra.uf} | ID: ${obra.id}`;
            document.getElementById('modalScore').innerText = obra.score;

            const content = document.getElementById('modalContent');
            content.innerHTML = `
            <div class="grid grid-cols-2 gap-4 mb-6 bg-slate-800/50 p-3 rounded-lg border border-slate-700">
                <div><p class="text-[10px] text-slate-500 uppercase">Empresa</p><p class="text-xs text-white font-bold truncate">${obra.empresa}</p></div>
                <div><p class="text-[10px] text-slate-500 uppercase">Valor</p><p class="text-xs text-white font-bold">${formatMoney(obra.valor)}</p></div>
                <div><p class="text-[10px] text-slate-500 uppercase">Vistoria</p><p class="text-xs text-white font-bold">${obra.vistoria ? parseDate(obra.vistoria).toLocaleDateString() : 'Sem Registro'}</p></div>
                <div><p class="text-[10px] text-slate-500 uppercase">Situação</p><p class="text-xs text-white font-bold">${obra.status}</p></div>
            </div>
            <h4 class="text-xs font-bold text-slate-400 uppercase mb-3 border-b border-slate-700 pb-1">Auditoria (19 Regras)</h4>`;

            if(obra.regras_quebradas.length === 0) content.innerHTML += `<div class="text-center py-4 text-emerald-400 text-sm">Regular. Nenhuma regra infringida.</div>`;
            else obra.regras_quebradas.forEach(r => {
                content.innerHTML += `
                <div class="detail-item">
                    <div class="flex justify-between items-start">
                        <span class="text-sm text-slate-200">${r.desc}</span>
                        <span class="tag-p${r.peso} tag-score">+${r.peso} pts</span>
                    </div>
                </div>`;
            });

            document.getElementById('detailModal').classList.remove('hidden');
        }

        function abrirModalEnte(nome) {
            const ente = DB.entes[nome];
            if(!ente) return;

            document.getElementById('modalType').innerText = "ENTE PÚBLICO";
            document.getElementById('modalTitle').innerText = ente.nome;
            document.getElementById('modalSubtitle').innerText = `${ente.uf} | ${ente.total_obras} Obras`;
            document.getElementById('modalScore').innerText = ente.risco_acumulado;

            const content = document.getElementById('modalContent');
            content.innerHTML = `<h4 class="text-xs font-bold text-slate-400 uppercase mb-3 border-b border-slate-700 pb-1">Obras com Alertas</h4>`;

            const obrasDoEnte = DB.obras.filter(o => o.municipio === nome && o.score > 0).sort((a,b) => b.score - a.score);

            if(obrasDoEnte.length === 0) content.innerHTML += `<div class="text-center py-4 text-emerald-400 text-sm">Nenhuma obra irregular encontrada.</div>`;
            else obrasDoEnte.forEach(o => {
                content.innerHTML += `
                <div class="detail-item">
                    <div class="flex justify-between items-center mb-1">
                        <span class="text-xs font-bold text-white truncate w-3/4">${o.nome}</span>
                        <span class="text-orange-400 font-black text-xs">+${o.score} pts</span>
                    </div>
                    <div class="text-[10px] text-slate-400 pl-2">
                        ${o.regras_quebradas.map(r => `• ${r.desc}`).join('<br>')}
                    </div>
                </div>`;
            });
            document.getElementById('detailModal').classList.remove('hidden');
        }

        function fecharModal() { document.getElementById('detailModal').classList.add('hidden'); }

        // Utils
        function parseMoney(v) { if(!v) return 0; if(typeof v === 'number') return v; return parseFloat(v.toString().replace("R$","").trim().replace(/\./g,"").replace(",",".")) || 0; }
        
        function parseDate(d) {
            if(!d) return null;
            if(typeof d === 'number') return new Date(Math.round((d-25569)*86400*1000));
            if(typeof d === 'string') {
                d = d.trim();
                // YYYY-MM-DD
                if(d.match(/^\d{4}-\d{2}-\d{2}$/)) { const p = d.split('-'); return new Date(p[0], p[1]-1, p[2]); }
                // DD/MM/YYYY
                if(d.includes('/')) { const p = d.split('/'); if(p.length===3) return new Date(p[2], p[1]-1, p[0]); }
            }
            return new Date(d); // Fallback
        }

        function diffDays(d1, d2) { if(!d1 || !d2) return 0; return Math.floor((d2 - d1) / (1000 * 60 * 60 * 24)); }
        function formatMoney(v) { return (v||0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }); }
    </script>
