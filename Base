            },
            {
                id: "1097774",
                nome: "Esc. Mun. Profª. Aldamarina de Souza Oliveira",
                municipio: "Barcelos",
                uf: "AM",
                ente: "PREFEITURA MUNICIPAL DE BARCELOS",
                cnpj_ente: "04.271.037/0001-05",
