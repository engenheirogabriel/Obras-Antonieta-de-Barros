            },
            {
                id: "1041572",
                nome: "Quadra Escolar Coberta com Vestiário",
                municipio: "Município Exemplo",
                uf: "BA",
                ente: "PREF MUN EXEMPLO",
                cnpj_ente: "99.999.999/0001-99",
                empresa: "ALADIM CONSTRUCOES E EMPREENDIMENTOS",
                cnpj_empresa: "48.326.623/0001-85",
                valor: 509000.00,
                inicio_vigencia: "2015-04-01",
                fim_vigencia: "2016-04-01",
                fisico: 63.24,
