                cnpj_empresa: "13.694.138/0001-80",
                valor: 3167407.61,
                inicio_vigencia: "2022-04-11",
                fim_vigencia: "2025-04-30",
                fisico: 45.00,
                financeiro: 15.00,
                status_obra: "Em Execução",
                status_fnde: "Diligência", // Fica indo e voltando (CSV Histórico)
                data_ultimo_pagamento: "11/04/2022",
                justificativa_aditivo: "Atrasos nos repasses federais e replanilhamento"
            }
        ];

        // ==============================================================================
        // 2. MOTOR DE RISCO (ALGORITMO ANTONIETA)
        // ==============================================================================
        const processarRisco = (obra) => {
            let score = 0;
            let flags = [];
            
            // Datas
            const hoje = new Date();
            const fim = new Date(obra.fim_vigencia);
            const inicio = new Date(obra.inicio_vigencia);
            const diasDecorridos = Math.floor((hoje - inicio) / (1000 * 60 * 60 * 24));
            
            // [PESO 20] Paralisia Crítica
            // Lógica: Status "Paralisada" OU <5% execução em 120 dias
            if (obra.status_obra === "Paralisada" || (diasDecorridos > 120 && obra.fisico < 5)) {
                score += 20;
                flags.push({ tipo: "PARALISIA", label: "Obra Paralisada/Estagnada", desc: "Sem evolução física significativa.", peso: 20 });
            }

            // [PESO 20] Discrepância Financeira (Sobrefaturamento)
            // Lógica: Financeiro > Físico + 10%
            if ((obra.financeiro - obra.fisico) > 10) {
                score += 20;
                flags.push({ tipo: "FINANCEIRO", label: "Discrepância Financeira", desc: `Pago ${obra.financeiro}% vs Executado ${obra.fisico}%`, peso: 20 });
            }

            // [PESO 20] Prazo Expirado
            if (hoje > fim && obra.fisico < 98 && obra.status_obra !== "Concluída") {
                score += 20;
                flags.push({ tipo: "PRAZO", label: "Vigência Expirada", desc: "Contrato vencido sem conclusão da obra.", peso: 20 });
            }

            // [PESO 10] Tramitação FNDE
            if (['Indeferido', 'Cancelado', 'Inadimplente'].includes(obra.status_fnde)) {
                score += 10;
                flags.push({ tipo: "TRAMITACAO", label: `Situação FNDE: ${obra.status_fnde}`, desc: "Pendências administrativas graves.", peso: 10 });
            }

            // [PESO 25] Risco Societário (Simulação baseada em EIRELI/ME em grandes obras)
            // No mundo real cruzaria com a API da Receita. Aqui usamos heurística do nome da empresa vs valor.
            const isEireli = obra.empresa.toUpperCase().includes("EIRELI");
            const isHighValue = obra.valor > 2000000;
            
            if (isEireli && isHighValue) {
                score += 25;
                flags.push({ tipo: "SOCIETARIO", label: "Risco Societário", desc: "Empresa individual (EIRELI) em contrato de alto valor.", peso: 25 });
            }
            
            // [PESO 15] Licitação (Falta de dados antigos ou atrasos)
            if (diasDecorridos > 365 && obra.fisico < 20) {
                 score += 15;
                 flags.push({ tipo: "GESTAO", label: "Baixa Eficiência", desc: "Menos de 20% executado em 1 ano.", peso: 15 });
            }

            return { ...obra, score, flags };
        };

        // ==============================================================================
        // 3. COMPONENTES DE UI
        // ==============================================================================

        const DetailModal = ({ obra, onClose }) => {
            if (!obra) return null;
            
            return (
                <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm fade-in">
                    <div className="bg-slate-900 w-full max-w-3xl rounded-2xl border border-slate-700 shadow-2xl overflow-hidden max-h-[90vh] overflow-y-auto">
                        
                        {/* Header Modal */}
                        <div className="p-6 bg-slate-800 border-b border-slate-700 flex justify-between items-start">
                            <div>
                                <div className="flex items-center gap-2 mb-2">
                                    <span className="bg-blue-600 text-white text-xs font-bold px-2 py-0.5 rounded">ID: {obra.id}</span>
                                    <span className="text-slate-400 text-sm">{obra.municipio}/{obra.uf}</span>
                                </div>
                                <h2 className="text-xl font-bold text-white leading-tight">{obra.nome}</h2>
                            </div>
                            <button onClick={onClose} className="p-2 hover:bg-slate-700 rounded-full text-slate-400 transition">
                                <X size={24} />
                            </button>
                        </div>

                        {/* Corpo Modal */}
                        <div className="p-6 space-y-6">
                            
                            {/* Score Banner */}
                            <div className="flex items-center gap-4 bg-slate-800/50 p-4 rounded-xl border border-slate-700">
                                <div className={`w-16 h-16 rounded-full flex items-center justify-center text-2xl font-black text-white shadow-lg ${obra.score >= 50 ? 'risk-gradient-high' : obra.score >= 20 ? 'risk-gradient-med' : 'risk-gradient-low'}`}>
                                    {obra.score}
                                </div>
                                <div>
                                    <h3 className="text-white font-bold">Pontuação de Risco</h3>
                                    <p className="text-slate-400 text-sm">Calculado com base em 6 vetores de análise (FNDE/TCU)</p>
                                </div>
                            </div>

                            {/* Detalhes Grid */}
                            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
