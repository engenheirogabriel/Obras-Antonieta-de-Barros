<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>FTC Transparência - Fiscalização de Obras</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- PapaParse (CSV Engine) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>

    <!-- SheetJS (Excel Engine) -->
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background-color: #0f172a; color: #e2e8f0; }
        .glass { background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255,255,255,0.1); }
        .card { background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255,255,255,0.05); transition: all 0.2s; }
        .card:active { transform: scale(0.99); background: rgba(30, 41, 59, 0.8); }
        
        /* Badges e Risco */
        .risk-badge { font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 2px 6px; border-radius: 4px; }
        .risk-critical { background: rgba(239,68,68,0.2); color: #fca5a5; border: 1px solid rgba(239,68,68,0.4); }
        .risk-warning { background: rgba(249,115,22,0.2); color: #fdba74; border: 1px solid rgba(249,115,22,0.4); }
        
        /* Loader e Progress */
        .loader { border: 3px solid rgba(255,255,255,0.1); border-left-color: #3b82f6; border-radius: 50%; width: 24px; height: 24px; animation: spin 1s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        
        /* Scroll Hide */
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="pb-24">

    <!-- HEADER -->
    <nav class="glass sticky top-0 z-50 px-4 py-3 shadow-2xl">
        <div class="flex justify-between items-center mb-4">
            <div class="flex items-center gap-3">
                <div class="bg-blue-600 p-2 rounded-lg shadow-lg shadow-blue-900/50">
                    <i data-lucide="search-check" class="text-white w-5 h-5"></i>
                </div>
                <div>
                    <h1 class="font-black text-white text-lg leading-none tracking-tight">FTC <span class="text-blue-500">TRANSPARÊNCIA</span></h1>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wide">Auditoria Cidadã</p>
                </div>
            </div>
            <label class="bg-slate-800 hover:bg-slate-700 text-white px-3 py-1.5 rounded-lg text-[10px] font-bold flex items-center gap-2 cursor-pointer border border-slate-700 transition">
                <i data-lucide="folder-input" class="w-3 h-3"></i> CARREGAR CSVs
                <input type="file" id="fileInput" multiple accept=".csv, .xlsx, .xls, .ods" class="hidden" onchange="iniciarProcessamento(this)">
            </label>
        </div>

        <!-- BARRA DE AÇÕES (BOTÕES SOLICITADOS) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
            <button onclick="auditar('ENTES')" class="action-btn bg-slate-800 border border-slate-700 text-slate-300 hover:text-white hover:bg-slate-700 px-2 py-2 rounded-lg flex flex-col items-center justify-center gap-1 transition disabled:opacity-30" disabled>
                <i data-lucide="landmark" class="w-4 h-4 text-blue-400"></i>
                <span class="text-[9px] font-bold uppercase">Entes</span>
            </button>
            <button onclick="auditar('CONTRATOS')" class="action-btn bg-slate-800 border border-slate-700 text-slate-300 hover:text-white hover:bg-slate-700 px-2 py-2 rounded-lg flex flex-col items-center justify-center gap-1 transition disabled:opacity-30" disabled>
                <i data-lucide="file-text" class="w-4 h-4 text-emerald-400"></i>
                <span class="text-[9px] font-bold uppercase">Contratos</span>
            </button>
            <button onclick="auditar('EMPRESAS')" class="action-btn bg-slate-800 border border-slate-700 text-slate-300 hover:text-white hover:bg-slate-700 px-2 py-2 rounded-lg flex flex-col items-center justify-center gap-1 transition disabled:opacity-30" disabled>
                <i data-lucide="building-2" class="w-4 h-4 text-orange-400"></i>
                <span class="text-[9px] font-bold uppercase">Empresas</span>
            </button>
            <button onclick="auditar('SOCIOS')" class="action-btn bg-slate-800 border border-slate-700 text-slate-300 hover:text-white hover:bg-slate-700 px-2 py-2 rounded-lg flex flex-col items-center justify-center gap-1 transition disabled:opacity-30" disabled>
                <i data-lucide="users" class="w-4 h-4 text-purple-400"></i>
                <span class="text-[9px] font-bold uppercase">Sócios</span>
            </button>
        </div>
    </nav>

    <!-- ESTADO VAZIO -->
    <div id="emptyState" class="p-8 text-center mt-8 animate-fade-in">
        <div class="bg-slate-800/50 w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6 border border-slate-700 shadow-inner">
            <i data-lucide="upload-cloud" class="w-10 h-10 text-slate-500"></i>
        </div>
        <h2 class="text-xl font-bold text-white mb-2">Importar Base de Dados</h2>
        <p class="text-slate-400 text-xs max-w-xs mx-auto mb-8 leading-relaxed">
            Selecione as planilhas do <strong>Antonieta de Barros</strong> (Informações Gerais, Pagamentos, Contratos) para iniciar a Malha Fina automática.
        </p>
    </div>

    <!-- LOADING SCREEN -->
    <div id="loadingOverlay" class="hidden fixed inset-0 bg-slate-900/95 z-[60] flex-col items-center justify-center text-center px-6 backdrop-blur-sm">
        <div class="loader w-12 h-12 mb-4 border-4"></div>
        <h3 class="text-white font-bold text-lg mb-1" id="loadingTitle">Processando</h3>
        <p class="text-slate-400 text-sm mb-4" id="loadingText">Aguarde...</p>
        <div class="w-full max-w-xs bg-slate-800 rounded-full h-1.5 overflow-hidden">
            <div id="progressBar" class="bg-blue-500 h-full transition-all duration-300" style="width: 0%"></div>
        </div>
    </div>

    <!-- ÁREA DE CONTEÚDO -->
    <div id="mainContent" class="hidden px-4 mt-6">
        
        <!-- CABEÇALHO DA VISÃO -->
        <div class="flex justify-between items-end mb-4 border-b border-slate-700 pb-2">
            <div>
                <h2 class="text-xl font-black text-white uppercase tracking-tight" id="viewTitle">Visão Geral</h2>
                <p class="text-[10px] text-slate-400" id="viewSubtitle">Resultados da auditoria automática</p>
            </div>
            <div class="text-right">
                <div class="text-2xl font-black text-orange-500" id="viewRiskCount">0</div>
                <div class="text-[9px] font-bold text-slate-500 uppercase">Irregularidades</div>
            </div>
        </div>

        <!-- LISTA DE RESULTADOS -->
        <div id="resultsList" class="space-y-3 pb-8">
            <!-- Inserido via JS -->
        </div>

        <!-- PAGINAÇÃO -->
        <button id="btnLoadMore" onclick="carregarMais()" class="hidden w-full py-3 bg-slate-800 text-slate-400 text-xs font-bold rounded-xl hover:bg-slate-700 transition">
            CARREGAR MAIS
        </button>
    </div>

    <!-- JAVASCRIPT ENGINE -->
    <script>
        lucide.createIcons();

        // --- ESTADO ---
        let DB = { obras: [], empresas: {}, entes: {} };
        let VIEW = { mode: 'DASHBOARD', page: 0, pageSize: 50, currentList: [] };

        // ============================================================
        // 1. LEITURA HÍBRIDA (CSV + EXCEL)
        // ============================================================
        async function iniciarProcessamento(input) {
            const files = Array.from(input.files);
            if (!files.length) return;

            toggleLoader(true, "Lendo arquivos...");
            let rawData = { geral: [], contrato: [], pagamentos: [], termos: [], historico: [] };
            let processed = 0;

            const updateProg = () => {
                processed++;
                document.getElementById('progressBar').style.width = `${(processed / files.length) * 100}%`;
            };

            const promises = files.map(file => new Promise(resolve => {
                const ext = file.name.split('.').pop().toLowerCase();
                
                if (ext === 'csv') {
                    Papa.parse(file, {
                        header: true, skipEmptyLines: true, worker: true, encoding: "ISO-8859-1",
                        complete: (res) => { categorizar(res.data, file.name, rawData); updateProg(); resolve(); },
                        error: () => { updateProg(); resolve(); }
                    });
                } else {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        try {
                            const wb = XLSX.read(new Uint8Array(e.target.result), { type: 'array' });
                            const json = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { defval: "" });
                            categorizar(json, file.name, rawData);
                        } catch(e) {}
                        updateProg(); resolve();
                    };
                    reader.readAsArrayBuffer(file);
                }
            }));

            await Promise.all(promises);
            document.getElementById('loadingText').innerText = "Aplicando Malha Fina (18 Regras)...";
            setTimeout(() => processarMalhaFina(rawData), 200);
        }

        function categorizar(json, fname, store) {
            fname = fname.toLowerCase();
            const keys = json[0] ? Object.keys(json[0]).map(k => k.toLowerCase()) : [];
            
            if (fname.includes("geral") || keys.includes("situação da obra")) store.geral.push(...json);
            else if (fname.includes("contrata")) store.contrato.push(...json);
            else if (fname.includes("pagamento") || keys.includes("valor da nota fiscal (r$)")) store.pagamentos.push(...json);
            else if (fname.includes("termos") || keys.includes("número do termo")) store.termos.push(...json);
            else if (fname.includes("histórico")) store.historico.push(...json);
        }

        // ============================================================
        // 2. MOTOR DE MALHA FINA (18 REGRAS)
        // ============================================================
        function processarMalhaFina(raw) {
            DB = { obras: [], empresas: {}, entes: {} };
            const mapObras = {};

            // Indexar Financeiro
            const pagamentos = {};
            raw.pagamentos.forEach(row => {
                const id = row["ID da obra"] || row["ID"];
                const val = parseMoney(row["Valor da nota fiscal (R$)"] || row["Valor"]);
                if(id) pagamentos[id] = (pagamentos[id] || 0) + val;
            });

            // Base Principal
            const base = raw.geral.length ? raw.geral : raw.contrato;
            
            base.forEach(row => {
                const id = row["ID da obra"] || row["ID"];
                if(!id) return;

                const obra = {
                    id: id,
                    nome: row["Nome da obra"] || "Obra Sem Nome",
                    municipio: row["Município"] || "Desconhecido",
                    uf: row["UF"] || "",
                    ente: row["Município"] ? `Pref. ${row["Município"]}` : "Governo Estadual",
                    status: row["Situação da obra"] || "N/A",
                    fisico: parseMoney(row["Percentual de execução"] || row["% Medição física acumulada"]),
                    financeiro: 0,
                    valor: 0,
                    empresa: "Não Informada",
                    cnpj: null,
                    data_termo: parseDate(row["Data da assinatura do termo"]),
                    data_inicio: null,
                    data_fim: null,
                    suspeitas: [],
                    score: 0
                };
                mapObras[id] = obra;
            });

            // Enriquecer e Auditar
            raw.contrato.forEach(row => {
                const id = row["ID da obra"];
                if(mapObras[id]) {
                    mapObras[id].valor = parseMoney(row["Valor do contrato"]);
                    mapObras[id].data_inicio = parseDate(row["Data de início da execução"]);
                    mapObras[id].data_fim = parseDate(row["Data de término do contrato"]);
                    
                    // Extrair Empresa
                    const empStr = row["Empresa contratada"];
                    if(empStr) {
                        const m = empStr.match(/\((\d+)\)\s*(.*)/);
                        if(m) { mapObras[id].cnpj = m[1]; mapObras[id].empresa = m[2]; }
                        else mapObras[id].empresa = empStr;
                    }
                }
            });

            // Executar Regras
            Object.values(mapObras).forEach(obra => {
                // Cálculo Financeiro
                if(obra.valor > 0) obra.financeiro = (pagamentos[obra.id] || 0) / obra.valor * 100;
                
                aplicarRegras(obra);
                
                // Popula DB
                DB.obras.push(obra);
                
                // Agrega Ente
                if(!DB.entes[obra.municipio]) DB.entes[obra.municipio] = { nome: obra.municipio, uf: obra.uf, obras: 0, riscos: 0, valor: 0, lista_suspeitas: new Set() };
                DB.entes[obra.municipio].obras++;
                DB.entes[obra.municipio].valor += obra.valor;
                DB.entes[obra.municipio].riscos += obra.score;
                obra.suspeitas.forEach(s => DB.entes[obra.municipio].lista_suspeitas.add(s));

                // Agrega Empresa
                if(obra.cnpj) {
                    if(!DB.empresas[obra.cnpj]) DB.empresas[obra.cnpj] = { cnpj: obra.cnpj, nome: obra.empresa, obras: 0, riscos: 0, valor: 0, socios: [], status_api: 'Pendente' };
                    DB.empresas[obra.cnpj].obras++;
                    DB.empresas[obra.cnpj].valor += obra.valor;
                    DB.empresas[obra.cnpj].riscos += obra.score;
                }
            });

            DB.obras.sort((a,b) => b.score - a.score);
            
            // Habilitar UI
            document.querySelectorAll('.action-btn').forEach(b => b.disabled = false);
            toggleLoader(false);
            document.getElementById('emptyState').classList.add('hidden');
            document.getElementById('mainContent').classList.remove('hidden');
            auditar('ENTES'); // Tela inicial
        }

        function aplicarRegras(obra) {
            const hoje = new Date();
            const diasDecorridos = obra.data_inicio ? diffDays(obra.data_inicio, hoje) : 0;
            
            // 1. Paralisia (<5% em 120 dias ou <15% em 1 ano)
            if (diasDecorridos > 120 && obra.fisico < 5) {
                flag(obra, 20, "Paralisia Inicial (<5% em 120 dias)");
            }
            if (diasDecorridos > 365 && obra.fisico < 15) {
                flag(obra, 20, "Lentidão Crítica (<15% em 1 ano)");
            }

            // 2. Descompasso Financeiro
            if ((obra.financeiro - obra.fisico) > 10) {
                flag(obra, 20, `Sobrefaturamento (>10%): Pago ${obra.financeiro.toFixed(0)}% vs Feito ${obra.fisico.toFixed(0)}%`);
            }
            
            // 3. Prazos
            if (obra.data_fim && hoje > obra.data_fim && obra.fisico < 98) {
                flag(obra, 15, "Vigência Expirada sem Conclusão");
            }

            // 4. Falta de OS (12 meses do Termo)
            if (obra.data_termo && !obra.data_inicio) {
                if (diffDays(obra.data_termo, hoje) > 365) {
                    flag(obra, 15, "Sem Ordem de Serviço há >12 meses");
                }
            }

            // 5. Situação FNDE
            if (['Indeferido', 'Cancelado', 'Inadimplente'].includes(obra.status)) {
                flag(obra, 10, `Situação FNDE: ${obra.status}`);
            }

            // 6. Risco Societário (Heurística Local)
            if (obra.empresa.includes("EIRELI") && obra.valor > 2000000) {
                flag(obra, 25, "Risco: Empresa EIRELI em contrato vultuoso");
            }
        }

        function flag(obra, pts, msg) {
            obra.score += pts;
            obra.suspeitas.push(msg);
        }

        // ============================================================
        // 3. AÇÕES DOS BOTÕES (AUDITORIA)
        // ============================================================
        
        function auditar(tipo) {
            VIEW.mode = tipo;
            VIEW.page = 0;
            
            document.querySelectorAll('.action-btn').forEach(b => b.classList.remove('bg-blue-600', 'text-white'));
            event.currentTarget?.classList.add('bg-blue-600', 'text-white'); // Highlight ativo

            if (tipo === 'ENTES') {
                document.getElementById('viewTitle').innerText = "AUDITORIA DE ENTES";
                document.getElementById('viewSubtitle').innerText = "Rankings de transparência e riscos acumulados por gestão.";
                VIEW.currentList = Object.values(DB.entes).sort((a,b) => b.riscos - a.riscos);
            } 
            else if (tipo === 'CONTRATOS') {
                document.getElementById('viewTitle').innerText = "AUDITORIA DE CONTRATOS (PNCP)";
                document.getElementById('viewSubtitle').innerText = "Monitoramento de vigência, execução e irregularidades contratuais.";
                VIEW.currentList = DB.obras;
            } 
            else if (tipo === 'EMPRESAS') {
                document.getElementById('viewTitle').innerText = "AUDITORIA DE EMPRESAS";
                document.getElementById('viewSubtitle').innerText = "Verificação de capital social, débitos e capacidade operacional.";
                VIEW.currentList = Object.values(DB.empresas).sort((a,b) => b.riscos - a.riscos);
                
                // Auto-trigger API se houver poucas empresas para não cansar o usuário
                if(VIEW.currentList.length < 50 && VIEW.currentList[0].status_api === 'Pendente') consultarAPIEmMassa();
            } 
            else if (tipo === 'SOCIOS') {
                document.getElementById('viewTitle').innerText = "AUDITORIA DE SÓCIOS (QSA)";
                document.getElementById('viewSubtitle').innerText = "Varredura de laranjas, idade de risco e vínculos políticos.";
                // Precisa ter rodado API de empresas primeiro
                const sociosMap = {};
                Object.values(DB.empresas).forEach(e => {
                    e.socios.forEach(s => {
                        if(!sociosMap[s.nome]) sociosMap[s.nome] = { nome: s.nome, empresas: new Set(), riscos: [] };
                        sociosMap[s.nome].empresas.add(e.nome);
                        // Regra idade (Simulada pois API as vezes falha idade)
                        if(s.faixa_etaria === 'Entre 16 a 20 anos' || s.faixa_etaria === 'Acima de 70 anos') sociosMap[s.nome].riscos.push("Idade de Risco");
                    });
                });
                VIEW.currentList = Object.values(sociosMap).sort((a,b) => b.empresas.size - a.empresas.size);
                
                if(VIEW.currentList.length === 0) {
                     alert("Para ver sócios, é necessário primeiro clicar em 'AUDITAR EMPRESAS' para buscar dados na Receita Federal.");
                     auditar('EMPRESAS');
                     return;
                }
            }

            document.getElementById('viewRiskCount').innerText = VIEW.currentList.reduce((acc, i) => acc + (i.score || i.riscos || 0), 0);
            renderizar();
        }

        // --- INTEGRAÇÃO API EXTERNA ---
        async function consultarAPIEmMassa() {
            if(!confirm("Consultar Receita Federal (BrasilAPI) para verificar QSA e Capital Social?")) return;
            
            toggleLoader(true, "Consultando Receita Federal...");
            const cnpjs = Object.keys(DB.empresas);
            let done = 0;

            for (const c => cnpjs) {
                if(done >= cnpjs.length) break;
                const cnpj = cnpjs[done];
                
                try {
                    const res = await fetch(`https://brasilapi.com.br/api/cnpj/v1/${cnpj}`);
                    if(res.ok) {
                        const json = await res.json();
                        const emp = DB.empresas[cnpj];
                        emp.status_api = 'Atualizado';
                        emp.capital_social = json.capital_social;
                        
                        // Regra Capital Social vs Valor Contrato
                        if(emp.valor_total > (json.capital_social * 10)) {
                            emp.riscos += 30; // Pontuação alta
                            // Flag em todas as obras dessa empresa
                            DB.obras.filter(o => o.cnpj === cnpj).forEach(o => {
                                o.score += 30;
                                o.suspeitas.push(`Empresa tem Capital Social incompatível (${formatMoney(json.capital_social)})`);
                            });
                        }

                        if(json.qsa) {
                            json.qsa.forEach(s => emp.socios.push({ 
                                nome: s.nome_socio, 
                                faixa_etaria: s.faixa_etaria,
                                qual: s.qualificacao_socio 
                            }));
                        }
                    }
                } catch(e) { console.log(e); }

                done++;
                document.getElementById('progressBar').style.width = `${(done/cnpjs.length)*100}%`;
                await new Promise(r => setTimeout(r, 600)); // Rate limit protection
            }
            toggleLoader(false);
            auditar(VIEW.mode); // Re-render
        }

        // ============================================================
        // 4. RENDERIZAÇÃO
        // ============================================================
        function renderizar(append = false) {
            const container = document.getElementById('resultsList');
            if(!append) container.innerHTML = "";

            const start = VIEW.page * VIEW.pageSize;
            const slice = VIEW.currentList.slice(start, start + VIEW.pageSize);

            if(slice.length === 0 && !append) {
                container.innerHTML = `<div class="text-center text-slate-500 py-10">Nenhum registro encontrado.</div>`;
                document.getElementById('btnLoadMore').classList.add('hidden');
                return;
            }

            slice.forEach(item => {
                let html = "";
                
                if (VIEW.mode === 'ENTES') {
                    const susps = Array.from(item.lista_suspeitas).slice(0, 3);
                    html = `
                    <div class="card p-4 rounded-xl">
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="text-white font-bold text-sm">${item.nome} <span class="text-slate-500 text-[10px]">${item.uf}</span></h3>
                            <div class="text-right">
                                <div class="text-lg font-black text-orange-500">${item.riscos} Pts</div>
                            </div>
                        </div>
                        <div class="bg-slate-800/50 p-2 rounded text-xs text-slate-300 mb-2 grid grid-cols-2 gap-2">
                            <div>Obras: <b>${item.obras}</b></div>
                            <div>Total: <b class="text-emerald-400">${formatMoney(item.valor)}</b></div>
                        </div>
                        <div class="flex flex-wrap gap-1">
                            ${susps.map(s => `<span class="risk-badge risk-warning">${s}</span>`).join('')}
                            ${item.lista_suspeitas.size > 3 ? `<span class="text-[9px] text-slate-500">+${item.lista_suspeitas.size - 3} alertas</span>` : ''}
                        </div>
                    </div>`;
                }
                else if (VIEW.mode === 'CONTRATOS') {
                    // Deep Links para PNCP e Transparência
                    const linkPNCP = `https://pncp.gov.br/app/editais?q=${encodeURIComponent(item.nome)}`;
                    const linkTransp = `https://portaldatransparencia.gov.br/busca?termo=${encodeURIComponent(item.nome)}`;
                    
                    html = `
                    <div class="card p-3 rounded-xl border-l-4 ${item.score >= 20 ? 'border-red-500' : 'border-emerald-500'}">
                        <div class="flex justify-between items-start mb-2">
                            <span class="bg-slate-700 text-white text-[10px] px-1.5 rounded font-mono">${item.id}</span>
                            <span class="text-[10px] text-slate-400 truncate max-w-[120px]">${item.municipio}</span>
                        </div>
                        <h3 class="text-sm font-bold text-white leading-tight mb-2">${item.nome}</h3>
                        
                        <div class="flex gap-2 mb-3">
                            <a href="${linkPNCP}" target="_blank" class="flex-1 bg-blue-900/30 hover:bg-blue-900/50 text-blue-300 text-[10px] py-1.5 rounded text-center border border-blue-900 transition">
                                <i data-lucide="search" class="w-3 h-3 inline"></i> Consultar PNCP
                            </a>
                            <a href="${linkTransp}" target="_blank" class="flex-1 bg-emerald-900/30 hover:bg-emerald-900/50 text-emerald-300 text-[10px] py-1.5 rounded text-center border border-emerald-900 transition">
                                <i data-lucide="external-link" class="w-3 h-3 inline"></i> Transparência
                            </a>
                        </div>

                        <div class="bg-slate-900/50 rounded p-2 mb-2 text-[10px]">
                            <div class="flex justify-between mb-1"><span>Físico:</span> <b class="text-blue-400">${item.fisico.toFixed(1)}%</b></div>
                            <div class="flex justify-between"><span>Financeiro:</span> <b class="${item.financeiro > item.fisico + 10 ? 'text-red-400' : 'text-emerald-400'}">${item.financeiro.toFixed(1)}%</b></div>
                        </div>

                        <div class="flex flex-col gap-1">
                            ${item.suspeitas.map(s => `<span class="risk-badge risk-critical flex items-center gap-1"><i data-lucide="alert-circle" class="w-3 h-3"></i> ${s}</span>`).join('')}
                        </div>
                    </div>`;
                }
                else if (VIEW.mode === 'EMPRESAS') {
                    html = `
                    <div class="card p-4 rounded-xl">
                        <div class="flex justify-between mb-2">
                            <h3 class="text-white font-bold text-sm truncate max-w-[200px]">${item.nome}</h3>
                            <span class="text-orange-500 font-bold text-xs">${item.riscos} Pts</span>
                        </div>
                        <p class="text-[10px] text-slate-400 font-mono mb-2">CNPJ: ${item.cnpj} | API: ${item.status_api}</p>
                        ${item.capital_social ? `<div class="text-[10px] text-slate-300 mb-1">Capital Social: <b>${formatMoney(item.capital_social)}</b></div>` : ''}
                        <div class="text-xs bg-slate-800 p-2 rounded text-slate-300 flex justify-between">
                            <span><b>${item.obras}</b> Obras</span>
                            <span>Total: <b class="text-emerald-400">${formatMoney(item.valor)}</b></span>
                        </div>
                    </div>`;
                }
                else if (VIEW.mode === 'SOCIOS') {
                    html = `
                    <div class="card p-3 rounded-xl flex items-center gap-3">
                        <div class="bg-slate-700 p-2 rounded-full"><i data-lucide="user" class="w-4 h-4 text-slate-300"></i></div>
                        <div class="flex-1">
                            <h3 class="text-white font-bold text-sm">${item.nome}</h3>
                            <p class="text-[10px] text-slate-400 truncate w-48">Vinculado a: ${Array.from(item.empresas).join(', ')}</p>
                        </div>
                        ${item.riscos.length > 0 ? `<div class="text-[9px] bg-red-900/50 text-red-200 px-2 py-1 rounded">ALERTA</div>` : ''}
                    </div>`;
                }

                container.insertAdjacentHTML('beforeend', html);
            });

            if (start + VIEW.pageSize < VIEW.currentList.length) document.getElementById('btnLoadMore').classList.remove('hidden');
            else document.getElementById('btnLoadMore').classList.add('hidden');
            
            lucide.createIcons();
        }

        function carregarMais() {
            VIEW.page++;
            renderizar(true);
        }

        // ============================================================
        // UTILS
        // ============================================================
        function toggleLoader(show, msg) {
            const el = document.getElementById('loadingOverlay');
            if(show) { el.classList.remove('hidden'); el.classList.add('flex'); document.getElementById('loadingText').innerText = msg; }
            else { el.classList.add('hidden'); el.classList.remove('flex'); }
        }
        function parseMoney(v) { if(!v) return 0; if(typeof v === 'number') return v; return parseFloat(v.toString().replace("R$","").trim().replace(/\./g,"").replace(",",".")) || 0; }
        function parseDate(d) { if(!d) return null; if(typeof d === 'number') return new Date(Math.round((d-25569)*86400*1000)); const p = d.split(/[\/\-]/); return p.length===3 ? new Date(p[2],p[1]-1,p[0]) : null; }
        function diffDays(d1, d2) { return Math.floor((d2 - d1) / (1000 * 60 * 60 * 24)); }
        function formatMoney(v) { return (v||0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', notation: 'compact' }); }

    </script>
</body>
</html>

