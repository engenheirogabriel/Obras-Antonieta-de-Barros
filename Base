                    <p class="text-[10px] text-slate-400 font-medium">Auditoria Cidadã</p>
                </div>
            </div>
            <!-- Botão Upload Mobile -->
            <label for="csvInput" class="bg-blue-600 hover:bg-blue-500 text-white px-3 py-2 rounded-lg text-xs font-bold flex items-center gap-2 cursor-pointer transition shadow-lg shadow-blue-900/40">
