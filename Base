                                </div>
                                <div className="text-3xl font-black text-white">{dadosProcessados.length}</div>
                            </div>
                            <div className="glass-panel p-5 rounded-xl border-l-4 border-l-red-500">
                                <div className="flex justify-between items-start mb-2">
                                    <div className="bg-red-500/10 p-2 rounded-lg text-red-500"><Siren size={20}/></div>
                                    <span className="text-xs text-slate-500 font-bold uppercase">Risco Crítico</span>
                                </div>
                                <div className="text-3xl font-black text-white">{dadosProcessados.filter(d => d.score >= 50).length}</div>
                            </div>
                            <div className="glass-panel p-5 rounded-xl">
                                <div className="flex justify-between items-start mb-2">
                                    <div className="bg-orange-500/10 p-2 rounded-lg text-orange-500"><DollarSign size={20}/></div>
                                    <span className="text-xs text-slate-500 font-bold uppercase">Valor Auditado</span>
                                </div>
                                <div className="text-3xl font-black text-white">
                                    {new Intl.NumberFormat('pt-BR', { notation: "compact", style: 'currency', currency: 'BRL' }).format(dadosProcessados.reduce((acc, curr) => acc + curr.valor, 0))}
                                </div>
                            </div>
                            <div className="glass-panel p-5 rounded-xl">
                                <div className="flex justify-between items-start mb-2">
                                    <div className="bg-purple-500/10 p-2 rounded-lg text-purple-500"><MapPin size={20}/></div>
                                    <span className="text-xs text-slate-500 font-bold uppercase">Municípios</span>
                                </div>
                                <div className="text-3xl font-black text-white">{[...new Set(dadosProcessados.map(d => d.municipio))].length}</div>
                            </div>
                        </div>

                        {/* Filtros Principais */}
                        <div className="mb-6">
                            <div className="flex flex-col sm:flex-row gap-3">
                                <button 
                                    onClick={() => setFiltro('RANKING')}
                                    className={`flex-1 py-3 px-4 rounded-xl font-bold text-sm flex items-center justify-center gap-2 transition-all ${filtro === 'RANKING' ? 'bg-orange-600 text-white shadow-lg shadow-orange-900/50' : 'glass-panel text-slate-400 hover:text-white hover:bg-slate-800'}`}
                                >
                                    <BarChart3 size={18} /> RANKING DE PONTOS
                                </button>
                                <button 
                                    onClick={() => setFiltro('PARALISADA')}
                                    className={`flex-1 py-3 px-4 rounded-xl font-bold text-sm flex items-center justify-center gap-2 transition-all ${filtro === 'PARALISADA' ? 'bg-red-600 text-white shadow-lg shadow-red-900/50' : 'glass-panel text-slate-400 hover:text-white hover:bg-slate-800'}`}
                                >
                                    <Calendar size={18} /> PARALISADAS / ATRASOS
                                </button>
                                <button 
                                    onClick={() => setFiltro('FINANCEIRO')}
                                    className={`flex-1 py-3 px-4 rounded-xl font-bold text-sm flex items-center justify-center gap-2 transition-all ${filtro === 'FINANCEIRO' ? 'bg-emerald-600 text-white shadow-lg shadow-emerald-900/50' : 'glass-panel text-slate-400 hover:text-white hover:bg-slate-800'}`}
                                >
                                    <DollarSign size={18} /> FINANCEIRO
                                </button>
                                <button 
                                    onClick={() => setFiltro('SOCIETARIO')}
                                    className={`flex-1 py-3 px-4 rounded-xl font-bold text-sm flex items-center justify-center gap-2 transition-all ${filtro === 'SOCIETARIO' ? 'bg-purple-600 text-white shadow-lg shadow-purple-900/50' : 'glass-panel text-slate-400 hover:text-white hover:bg-slate-800'}`}
                                >
                                    <ShieldAlert size={18} /> SOCIETÁRIO
                                </button>
                            </div>
                        </div>

                        {/* Lista de Resultados */}
                        <div className="space-y-4 fade-in">
                            {listaExibicao.length > 0 ? listaExibicao.map((obra) => (
                                <div key={obra.id} className="glass-panel p-0 rounded-xl hover:border-orange-500/50 transition-colors group">
                                    <div className="flex flex-col md:flex-row">
                                        
                                        {/* Coluna Esquerda: Score */}
                                        <div className="p-6 flex flex-col items-center justify-center border-b md:border-b-0 md:border-r border-slate-700 bg-slate-800/30 w-full md:w-32 shrink-0">
                                            <div className={`w-14 h-14 rounded-full flex items-center justify-center text-xl font-black text-white mb-2 shadow-inner ${obra.score >= 50 ? 'risk-gradient-high' : obra.score >= 20 ? 'risk-gradient-med' : 'risk-gradient-low'}`}>
                                                {obra.score}
                                            </div>
                                            <span className="text-[10px] font-bold uppercase tracking-wider text-slate-500">Score</span>
                                        </div>

                                        {/* Coluna Central: Dados */}
                                        <div className="p-6 flex-grow">
                                            <div className="flex items-center gap-3 mb-2">
                                                <span className={`px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide border ${obra.score >= 50 ? 'bg-red-500/10 border-red-500/20 text-red-500' : 'bg-green-500/10 border-green-500/20 text-green-500'}`}>
                                                    {obra.score >= 50 ? 'Risco Alto' : obra.score >= 20 ? 'Risco Médio' : 'Risco Baixo'}
                                                </span>
                                                <span className="text-slate-500 text-xs font-mono">{obra.id}</span>
                                            </div>
                                            <h3 className="text-lg font-bold text-white mb-1 leading-snug group-hover:text-orange-400 transition-colors">{obra.nome}</h3>
                                            <p className="text-sm text-slate-400 flex items-center gap-1 mb-4">
                                                <MapPin size={12} /> {obra.municipio} - {obra.uf}
                                            </p>

                                            <div className="grid grid-cols-2 gap-4">
                                                <div>
                                                    <div className="text-[10px] text-slate-500 uppercase font-bold mb-1">Evolução Física</div>
                                                    <div className="flex items-center gap-2">
                                                        <div className="flex-grow h-1.5 bg-slate-700 rounded-full overflow-hidden">
                                                            <div className="h-full bg-blue-500" style={{ width: `${obra.fisico}%` }}></div>
                                                        </div>
                                                        <span className="text-xs font-bold text-blue-400">{obra.fisico}%</span>
                                                    </div>
                                                </div>
                                                <div>
                                                    <div className="text-[10px] text-slate-500 uppercase font-bold mb-1">Pagamentos</div>
                                                    <div className="flex items-center gap-2">
                                                        <div className="flex-grow h-1.5 bg-slate-700 rounded-full overflow-hidden">
                                                            <div className={`h-full ${obra.financeiro > obra.fisico + 10 ? 'bg-red-500' : 'bg-emerald-500'}`} style={{ width: `${obra.financeiro}%` }}></div>
                                                        </div>
                                                        <span className={`text-xs font-bold ${obra.financeiro > obra.fisico + 10 ? 'text-red-400' : 'text-emerald-400'}`}>{obra.financeiro}%</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        {/* Coluna Direita: Ação */}
                                        <div className="p-6 flex flex-col justify-center items-end border-t md:border-t-0 md:border-l border-slate-700 bg-slate-800/30 w-full md:w-48 shrink-0">
                                            <div className="text-right mb-3">
                                                <div className="text-xs text-slate-500">Contratada</div>
                                                <div className="text-xs font-bold text-white truncate w-32" title={obra.empresa}>{obra.empresa.substring(0, 20)}...</div>
                                            </div>
                                            <button 
                                                onClick={() => setSelectedObra(obra)}
                                                className="w-full py-2 bg-slate-700 hover:bg-orange-600 text-white rounded-lg text-xs font-bold transition-all flex items-center justify-center gap-2"
                                            >
                                                ANALISAR <TrendingUp size={14} />
                                            </button>
                                        </div>
                                    </div>
                                    
                                    {/* Flags Footer */}
                                    {obra.flags.length > 0 && (
                                        <div className="px-6 py-3 bg-red-500/5 border-t border-slate-800 flex flex-wrap gap-2">
                                            {obra.flags.map((f, i) => (
                                                <span key={i} className="text-[10px] uppercase font-bold text-red-400 flex items-center gap-1 bg-red-900/20 px-2 py-1 rounded">
                                                    <AlertTriangle size={10} /> {f.label}
                                                </span>
                                            ))}
                                        </div>
                                    )}
                                </div>
                            )) : (
                                <div className="text-center py-20">
                                    <div className="bg-slate-800 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
                                        <Search size={32} className="text-slate-600" />
                                    </div>
                                    <h3 className="text-white font-bold text-lg">Nenhum resultado encontrado</h3>
                                    <p className="text-slate-500">Tente ajustar os filtros ou a busca.</p>
                                </div>
                            )}
                        </div>

                    </main>

                    {/* Modal */}
                    {selectedObra && (
                        <DetailModal obra={selectedObra} onClose={() => setSelectedObra(null)} />
                    )}
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>

