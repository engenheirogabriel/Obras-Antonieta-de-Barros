                valor: 2913500.00,
                inicio_vigencia: "2025-05-19",
                fim_vigencia: "2026-03-15",
                fisico: 67.92,
                financeiro: 100.00, // CSV Repasse FNDE: 100% repassado em empenhos antigos recuperados
                status_obra: "Em Execução",
