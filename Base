    <!-- ÁREA DE CONTEÚDO -->
    <main class="flex-grow p-4 max-w-5xl mx-auto w-full">
        
        <!-- ESTADO INICIAL (SEM DADOS) -->
        <div id="emptyState" class="flex flex-col items-center justify-center py-20 text-center animate-fade-in">
            <div class="bg-slate-800 p-6 rounded-full mb-4 shadow-inner">
                <i data-lucide="database" class="w-12 h-12 text-slate-600"></i>
            </div>
            <h2 class="text-xl font-bold text-white mb-2">Aguardando Base de Dados</h2>
            <p class="text-slate-400 max-w-xs mx-auto text-sm mb-6">
                Para iniciar, clique no botão "DADOS" acima e selecione os arquivos CSV exportados do Antonieta/FNDE.
            </p>
            <div class="text-xs text-slate-600 bg-slate-900/50 p-3 rounded border border-slate-800">
                Arquivos suportados: Informações Gerais, Contratação, Pagamentos...
            </div>
        </div>

