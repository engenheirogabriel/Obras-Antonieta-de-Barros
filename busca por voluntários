import pandas as pd
import networkx as nx
import time

# --- CONFIGURAÇÃO DE ARQUIVOS ---
file_path = "Cidades voluntários e obras.xlsx"
output_file = "Resultado_Codigos_Voluntarios.xlsx"

start_time = time.time()

print("1. Carregando e tratando os dados das planilhas...")
df_alvo = pd.read_excel(file_path, sheet_name='alvo')
df_voluntarios = pd.read_excel(file_path, sheet_name='voluntários')
df_rotas = pd.read_excel(file_path, sheet_name='rotas_regic2018_brasil')

# Padronizar chaves textuais (Cidade - UF)
df_alvo['Cidade_ID'] = df_alvo['Municipio'].str.strip() + " - " + df_alvo['UF'].str.strip()
df_voluntarios['Cidade_ID'] = df_voluntarios['Nome Municipio'].str.strip() + " - " + df_voluntarios['Sigla Uf'].str.strip()

# Função de limpeza para a coluna 'km'
def limpar_quilometragem(val):
    if isinstance(val, (int, float)):
        return float(val)
    if isinstance(val, str):
        val = val.replace(',', '.').strip()
        try:
            return float(val)
        except:
            return None
    return None

df_rotas['km_limpo'] = df_rotas['km'].apply(limpar_quilometragem)
df_rotas = df_rotas.dropna(subset=['km_limpo'])

print("2. Construindo o grafo da rede de transportes nacional...")
G = nx.Graph()
for _, row in df_rotas.iterrows():
    orig = f"{row['nome_o'].strip()} - {row['sig_uf_o'].strip()}"
    dest = f"{row['nome_d'].strip()} - {row['sig_uf_d'].strip()}"
    dist = row['km_limpo']
    
    if G.has_edge(orig, dest):
        if dist < G[orig][dest]['weight']:
            G[orig][dest]['weight'] = dist
    else:
        G.add_edge(orig, dest, weight=dist)

print("3. Rastreando e listando códigos de voluntários em um raio de 20,99 km...")
resultados_com_codigos = []
cidades_com_obras = df_alvo['Cidade_ID'].unique()

for cidade_obra in cidades_com_obras:
    codigos_proximos = []
    
    # Passo 1: Captura os voluntários que moram na própria cidade da obra (distância 0 km)
    df_proprios = df_voluntarios[df_voluntarios['Cidade_ID'] == cidade_obra]
    if not df_proprios.empty:
        codigos_proximos.extend(df_proprios['Cod'].astype(str).tolist())
        
    # Passo 2: Captura voluntários em cidades vizinhas por interpolação (até 20,99 km)
    if cidade_obra in G:
        cidades_proximas = nx.single_source_dijkstra_path_length(G, source=cidade_obra, cutoff=20.99, weight='weight')
        for cid_prox in cidades_proximas:
            if cid_prox != cidade_obra:
                df_vizinhos = df_voluntarios[df_voluntarios['Cidade_ID'] == cid_prox]
                if not df_vizinhos.empty:
                    codigos_proximos.extend(df_vizinhos['Cod'].astype(str).tolist())
                    
    # Recuperar os dados originais da cidade com obras
    row_original = df_alvo[df_alvo['Cidade_ID'] == cidade_obra].iloc[0]
    
    # Estrutura base da linha
    registro = {
        'Municipio': row_original['Municipio'],
        'UF': row_original['UF'],
        'Obras alvo': row_original['Obras alvo'],
        'Total Voluntários Próximos': len(codigos_proximos)
    }
    
    # Passo 3: Cria dinamicamente as colunas ao lado com os códigos
    for idx, cod in enumerate(codigos_proximos, 1):
        registro[f'Código Voluntário {idx}'] = cod
        
    resultados_com_codigos.append(registro)

print("4. Ordenando e exportando o relatório final para o Excel...")
df_resultado_final = pd.DataFrame(resultados_com_codigos)

# Ordena de forma decrescente pela quantidade total de voluntários mapeados nas redondezas
df_resultado_final = df_resultado_final.sort_values(by='Total Voluntários Próximos', ascending=False).reset_index(drop=True)

df_resultado_final.to_excel(output_file, index=False)
print(f"\nSucesso! Relatório gerado em {(time.time() - start_time):.2f} segundos.")
