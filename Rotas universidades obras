import pandas as pd
import networkx as nx
import time

print("1. Carregando os arquivos de dados...")
file_path = "Distancias entre cidades.xlsx"

df_rotas = pd.read_excel(file_path, sheet_name='rotas_regic2018_brasil')
df_origem = pd.read_excel(file_path, sheet_name='Cidades origem')
df_destino = pd.read_excel(file_path, sheet_name='Cidades destino')

print("2. Construindo a malha rodoviária (Grafo)...")
G = nx.Graph()
for _, row in df_rotas.dropna(subset=['nome_o', 'nome_d', 'km']).iterrows():
    origem_id = f"{row['nome_o'].strip()} - {row['sig_uf_o'].strip()}"
    destino_id = f"{row['nome_d'].strip()} - {row['sig_uf_d'].strip()}"
    
    if G.has_edge(origem_id, destino_id):
        if row['km'] < G[origem_id][destino_id]['weight']:
            G[origem_id][destino_id]['weight'] = row['km']
    else:
        G.add_edge(origem_id, destino_id, weight=row['km'])

# Listas únicas de cidades
lista_origens = (df_origem['Cidade polo Universidade'].str.strip() + " - " + df_origem['UF'].str.strip()).unique()
lista_destinos = (df_destino['Municipio'].str.strip() + " - " + df_destino['UF'].str.strip()).unique()

print(f"3. Processando {len(lista_origens)} origens cruzadas com {len(lista_destinos)} destinos...")
start_time = time.time()
resultados = []

# O PULO DO GATO: Processar por Origem em lote rápido
for i, orig in enumerate(lista_origens, 1):
    if orig not in G:
        continue
        
    # Calcula TODOS os menores caminhos a partir desta origem de uma vez só
    distancias, caminhos = nx.single_source_dijkstra(G, source=orig, weight='weight')
    
    for dest in lista_destinos:
        if dest in distancias:
            caminho_cidades = caminhos[dest]
            intermediarias = len(caminho_cidades) - 2
            
            resultados.append({
                'Origem': orig,
                'Destino': dest,
                'Distancia_Km': round(distancias[dest], 2),
                'Cidades_no_Caminho': " -> ".join(caminho_cidades),
                'Conexoes_Intermediarias': max(0, intermediarias)
            })
        else:
            resultados.append({
                'Origem': orig,
                'Destino': dest,
                'Distancia_Km': None,
                'Cidades_no_Caminho': "Sem rota disponível",
                'Conexoes_Intermediarias': None
            })
            
    if i % 50 == 0 or i == len(lista_origens):
        print(f"   Progresso: {i}/{len(lista_origens)} cidades de origem processadas...")

print("4. Salvando os resultados no Excel (isso pode demorar uns segundos devido ao tamanho do arquivo)...")
df_resultado_final = pd.DataFrame(resultados)
df_resultado_final = df_resultado_final.dropna(subset=['Distancia_Km']).sort_values(by='Distancia_Km')
df_resultado_final.to_excel("Menores_Rotas_Cruzadas.xlsx", index=False)

print(f"\nProcessamento concluído em {((time.time() - start_time)/60):.2f} minutos!")
print("O arquivo 'Menores_Rotas_Cruzadas.xlsx' foi gerado com sucesso.")
