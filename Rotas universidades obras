import pandas as pd
import networkx as nx

# --- CONFIGURAÇÃO DE ARQUIVOS ---
file_path = "Distancias entre cidades.xlsx"
output_file = "Analise_Otimizada_Rotas.xlsx"

print("1. Carregando dados do Excel...")
df_rotas = pd.read_excel(file_path, sheet_name='rotas_regic2018_brasil')
df_origem = pd.read_excel(file_path, sheet_name='Cidades origem')
df_destino = pd.read_excel(file_path, sheet_name='Cidades destino')

print("2. Construindo malha viária rápida (Grafo)...")
G = nx.Graph()
for _, row in df_rotas.dropna(subset=['nome_o', 'nome_d', 'km']).iterrows():
    origem_id = f"{row['nome_o'].strip()} - {row['sig_uf_o'].strip()}"
    destino_id = f"{row['nome_d'].strip()} - {row['sig_uf_d'].strip()}"
    if G.has_edge(origem_id, destino_id):
        if row['km'] < G[origem_id][destino_id]['weight']:
            G[origem_id][destino_id]['weight'] = row['km']
    else:
        G.add_edge(origem_id, destino_id, weight=row['km'])

# Criar chaves padronizadas para origens e destinos
lista_origens = (df_origem['Cidade polo Universidade'].str.strip() + " - " + df_origem['UF'].str.strip()).unique()
lista_destinos = (df_destino['Municipio'].str.strip() + " - " + df_destino['UF'].str.strip()).unique()

# Criar dicionário auxiliar para mapear as obras de cada destino de forma instantânea
df_destino['Destino_ID'] = df_destino['Municipio'].str.strip() + " - " + df_destino['UF'].str.strip()
dict_obras = df_destino.set_index('Destino_ID')['Obras alvo'].to_dict()

print("3. Calculando menores caminhos e aplicando filtros...")
resultados = []

for orig in lista_origens:
    if orig not in G:
        continue
    
    # Calcula todos os menores caminhos a partir desta origem de uma vez só (Super Otimizado)
    distancias, caminhos = nx.single_source_dijkstra(G, source=orig, weight='weight')
    
    for dest in lista_destinos:
        if dest in distancias:
            dist_km = round(distancias[dest], 2)
            
            # CRITÉRIO 1: Filtrar os deslocamentos encontrados com até 50,99 km de forma imediata
            if dist_km <= 50.99:
                caminho_cidades = caminhos[dest]
                resultados.append({
                    'Origem': orig,
                    'Destino': dest,
                    'Distancia_Km': dist_km,
                    'Cidades_no_Caminho': " -> ".join(caminho_cidades),
                    'Obras_do_Destino': dict_obras.get(dest, 0)
                })

# Transformar em DataFrame para manipulação avançada
df_criterio1 = pd.DataFrame(resultados)

# CRITÉRIO 2: Rankear as 5 menores distâncias filtradas para cada destino
print("4. Aplicando Ranking das 5 menores distâncias por Destino...")
df_criterio1['Rank_Distancia'] = df_criterio1.groupby('Destino')['Distancia_Km'].rank(method='first', ascending=True)
df_criterio2 = df_criterio1[df_criterio1['Rank_Distancia'] <= 5].copy()

# CRITÉRIO 3: Rankear o número de obras para cada origem que atende aos dois critérios anteriores
print("5. Calculando volume de obras por cidade de Origem (Critério 3)...")
df_criterio3 = df_criterio2.groupby('Origem').agg(
    Total_Destinos_Atendidos=('Destino', 'count'),
    Total_Obras_Alvo_Atendidas=('Obras_do_Destino', 'sum')
).reset_index()

# Ordenar o ranking de origens do maior número de obras para o menor
df_criterio3 = df_criterio3.sort_values(by='Total_Obras_Alvo_Atendidas', ascending=False).reset_index(drop=True)

print(f"6. Exportando relatórios consolidados para o arquivo '{output_file}'...")
with pd.ExcelWriter(output_file, engine='openpyxl') as writer:
    df_criterio1.drop(columns=['Obras_do_Destino']).to_excel(writer, sheet_name='1- Rotas ate 50.99km', index=False)
    df_criterio2.drop(columns=['Obras_do_Destino']).to_excel(writer, sheet_name='2- Top 5 por Destino', index=False)
    df_criterio3.to_excel(writer, sheet_name='3- Ranking de Obras por Origem', index=False)

print("\nTodo o processo foi concluído com sucesso e os rankings foram salvos!")
